---
import SEO from "@/components/SEO.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Thread from "@/components/Thread.astro";

import "@/styles/global.css";
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";

import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import archivoLatinExt from "@fontsource-variable/archivo/files/archivo-latin-ext-wdth-normal.woff2?url";

const lang = Astro.currentLocale || "en";
---

<!doctype html>
<html lang={lang}>
    <head>
        <SEO />
        <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={archivoLatinExt} crossorigin />
    </head>
    <body>
        <a class="skip-link" href="#work">Skip to content</a>
        <SiteHeader />
        <Thread />
        <main id="main">
            <slot />
        </main>
    </body>
</html>

<script>
    // The page is complete without this: every act has a static composition.
    // So the scroll engine (GSAP, ScrollTrigger, Lenis) is not even fetched
    // until the first paint is done and the browser is idle. On a throttled
    // phone its parse and setup used to sit between the hero image arriving
    // and the hero image being painted.
    const start = () =>
        Promise.all([import("@/scripts/scroll"), import("@/scripts/scrub")]).then(([scroll, scrub]) => {
            scroll.initPage();
            scrub.initScrub();
        });
    const idle = () =>
        "requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 700 }) : setTimeout(start, 1);
    if (document.readyState === "complete") idle();
    else window.addEventListener("load", idle, { once: true });
</script>

<style is:global>
    .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-bone);
        color: var(--color-room);
        padding: 0.75rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }
    .skip-link:focus {
        left: 1rem;
        top: 1rem;
    }
</style>
