---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Manifesto from "@/components/Manifesto.astro";
import Work from "@/components/Work.astro";
import ScrubStage from "@/components/ScrubStage.astro";
import Record from "@/components/Record.astro";
import Contact from "@/components/Contact.astro";

import { useTranslations, type Locale } from "@/i18n/utils";
import plateInstrument from "@/assets/plates/instrument.jpg";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<Layout>
    <Hero />
    <Manifesto />
    <Work />
    <ScrubStage
        poster={plateInstrument}
        alt={t("plates.instrument")}
        src="/media/dial.mp4"
        srcMobile="/media/dial-m.mp4"
        span={3}
        label={t("scrub.label")}
        caption={t("scrub.caption")}
        stop={t("thread.measure")}
    />
    <Record />
    <Contact />
</Layout>
