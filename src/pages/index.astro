---
// Language gate, for local use only. In production public/_redirects answers /
// with a 301 to /en/ before this page is reached. Under astro dev and astro
// preview it renders a real document (so a crawler or a visitor without JS
// still gets links), sends a meta refresh, and moves to /tr/ when the browser
// asks for Turkish.
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>Emircan Erdemci | Frontend Developer</title>
        <link rel="canonical" href="https://emircyn.com/en/" />
        <meta name="robots" content="noindex,follow" />
        <link rel="alternate" hreflang="en" href="https://emircyn.com/en/" />
        <link rel="alternate" hreflang="tr" href="https://emircyn.com/tr/" />
        <link
            rel="alternate"
            hreflang="x-default"
            href="https://emircyn.com/en/"
        />
        <meta http-equiv="refresh" content="0;url=/en/" />
        <script is:inline>
            if (navigator.language && navigator.language.startsWith("tr")) {
                window.location.replace("/tr/");
            } else {
                window.location.replace("/en/");
            }
        </script>
    </head>
    <body>
        <p>
            <a href="/en/">Continue in English</a>
        </p>
        <p>
            <a href="/tr/">Türkçe devam et</a>
        </p>
    </body>
</html>
