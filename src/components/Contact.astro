---
import { useTranslations, type Locale } from "@/i18n/utils";
import { site } from "@/config";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const headingLines = t("contact.headingLines") as string[];

---

<!-- Act 6, the close. The page stops moving and starts answering: the light
     follows the pointer, the address pulls toward it. Nothing after this. -->
<section
    id="contact"
    class="close grain"
    data-close
    data-thread-stop={t("thread.contact")}
    aria-labelledby="contact-heading"
>
    <div class="close__pin" data-close-pin>
        <div class="close__light" data-close-light aria-hidden="true"></div>

        <div class="shell close__frame">
            <span class="label close__label">{t("contact.label")}</span>

            <h2 id="contact-heading" class="close__heading">
                {
                    headingLines.map((line, i) => (
                        <span
                            class={`close__line${i % 2 === 1 ? " close__line--lit" : ""}`}
                            data-close-line
                        >
                            {line}
                        </span>
                    ))
                }
            </h2>

            <p class="close__body pretty" data-close-body>{t("contact.body")}</p>

            <a class="close__action" href={`mailto:${site.email}`} data-magnet>
                <span class="close__action-text">{t("contact.action")}</span>
                <span class="close__action-addr label">{site.email}</span>
            </a>

            <ul class="close__links">
                <li>
                    <a href={site.github} target="_blank" rel="noreferrer">
                        {t("contact.github")}
                    </a>
                </li>
                <li>
                    <a href={site.linkedin} target="_blank" rel="noreferrer">
                        {t("contact.linkedin")}
                    </a>
                </li>
                <li>
                    <a href={site.repo} target="_blank" rel="noreferrer">
                        {t("contact.sourceCode")}
                    </a>
                </li>
            </ul>
        </div>

        <footer class="shell close__colophon">
            <span>{new Date().getFullYear()} {t("footer.rights")}</span>
        </footer>
    </div>
</section>

<style>
    .close {
        position: relative;
        background: var(--color-room);
        isolation: isolate;
    }
    .close__pin {
        position: relative;
        min-height: 100dvh;
        display: grid;
        grid-template-rows: 1fr auto;
        overflow: hidden;
    }
    .close__light {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(
            38vmax 38vmax at var(--lx, 30%) var(--ly, 60%),
            rgba(255, 50, 71, 0.22),
            rgba(255, 50, 71, 0.06) 40%,
            transparent 70%
        );
        will-change: background-position;
        z-index: 0;
    }
    .close__frame {
        position: relative;
        z-index: 1;
        display: grid;
        align-content: center;
        gap: calc(var(--spacing) * 4);
        padding-block: calc(var(--spacing) * 14) calc(var(--spacing) * 8);
    }
    .close__heading {
        margin: 0;
        display: grid;
        font-family: var(--font-display);
        font-variation-settings:
            "wdth" 80,
            "wght" 800;
        text-transform: uppercase;
        font-size: clamp(3rem, 9.5vw, 10.5rem);
        line-height: 0.88;
        letter-spacing: -0.02em;
    }
    .close__line {
        display: block;
        will-change: transform, opacity;
    }
    .close__line--lit {
        color: var(--color-red-lit);
    }
    .close__body {
        margin: 0;
        max-width: 38ch;
        font-size: clamp(1.1rem, 1.6vw, 1.4rem);
        color: var(--g-ink-soft);
    }
    .close__action {
        justify-self: start;
        display: grid;
        gap: 0.35rem;
        padding: 1.1rem 1.5rem;
        border: 1px solid var(--g-rule-strong);
        background: var(--color-room-lift);
        will-change: transform;
        transition:
            background-color 160ms var(--ease-out),
            border-color 160ms var(--ease-out);
    }
    .close__action:active {
        transform: scale(0.97);
    }
    .close__action-text {
        font-variation-settings:
            "wdth" 92,
            "wght" 700;
        font-size: 1.25rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }
    .close__action-addr {
        text-transform: none;
        letter-spacing: 0.04em;
    }
    @media (hover: hover) and (pointer: fine) {
        .close__action:hover {
            border-color: var(--color-red-lit);
            background: var(--color-red-lit);
            color: var(--color-room);
        }
        .close__action:hover .label {
            color: var(--color-room);
        }
    }
    .close__links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 3);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .close__links a {
        border-bottom: 1px solid var(--g-rule-strong);
        padding-bottom: 0.2rem;
    }
    .close__colophon {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 3);
        justify-content: space-between;
        padding-block: calc(var(--spacing) * 2.5);
        border-top: 1px solid var(--g-rule);
        font-family: var(--font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--g-ink-soft);
    }

    @media (max-width: 767px) {
        .close__frame {
            padding-top: calc(var(--spacing) * 10);
        }
        .close__colophon {
            flex-direction: column;
            gap: calc(var(--spacing) * 1);
        }
    }
</style>
