---
import { useTranslations, type Locale } from "@/i18n/utils";
import { site } from "@/config";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

// Explicit lines rather than a wrapping heading, so one of them can be set as
// an outline. A heading that relies on where the browser happens to break is a
// heading whose composition changes with the viewport.
const headingLines = t("contact.headingLines") as string[];
---

<!-- The close. The only reversed surface on the page, so the page resolves
     into a held state rather than trailing off into a footer. -->
<section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="shell contact__inner">
        <span class="label contact__label">{t("contact.label")}</span>

        <h2 id="contact-heading" class="contact__heading">
            {
                headingLines.map((line, i) => (
                    <span
                        class={`contact__line${i % 2 === 1 ? " contact__line--outline" : ""}`}
                    >
                        {line}
                    </span>
                ))
            }
        </h2>

        <p class="contact__body pretty">{t("contact.body")}</p>

        <a class="contact__action" href={`mailto:${site.email}`}>
            <span class="contact__action-text">{t("contact.action")}</span>
            <span class="contact__action-addr">{site.email}</span>
        </a>

        <ul class="contact__links">
            <li>
                <a href={site.github} target="_blank" rel="noreferrer">
                    {t("contact.github")}
                </a>
            </li>
            <li>
                <a href={site.linkedin} target="_blank" rel="noreferrer">
                    {t("contact.linkedin")}
                </a>
            </li>
            <li>
                <a href={site.repo} target="_blank" rel="noreferrer">
                    {t("contact.sourceCode")}
                </a>
            </li>
        </ul>
    </div>
</section>

<style>
    /* The one ending. The colophon continues this surface with no seam, so
       the bottom padding stops short of what a closing block would take: the
       block and its fine print are one object. */
    .contact {
        background-color: var(--color-accent);
        color: var(--color-paper);
        padding-block: calc(var(--spacing) * 16) calc(var(--spacing) * 7);
        margin-top: calc(var(--spacing) * 8);
    }

    .contact__inner {
        display: grid;
        gap: calc(var(--spacing) * 3);
    }

    .contact__label,
    .contact__body {
        color: rgba(241, 241, 239, 0.82);
    }

    .contact__heading {
        margin: 0;
        display: grid;
        /* Opened right up: the close is the one place on the page that is
           allowed to take its time. */
        row-gap: calc(var(--spacing) * 2.5);
        font-family: var(--font-display);
        text-transform: uppercase;
        font-size: clamp(2.5rem, 9vw, 7rem);
        line-height: 0.9;
        font-variation-settings:
            "wdth" 78,
            "wght" 800;
    }

    .contact__line {
        display: block;
    }

    /* Second line drawn rather than printed, in the paper the block is
       reversed out of. Same device as the hero and the footer mark. */
    .contact__line--outline {
        color: transparent;
        -webkit-text-stroke: 0.014em var(--color-paper);
    }

    @media (min-width: 768px) {
        .contact__heading {
            row-gap: calc(var(--spacing) * 4);
        }
    }

    .contact__body {
        margin: 0;
        max-width: 40ch;
        font-size: 1.0625rem;
    }

    .contact__action {
        justify-self: start;
        display: grid;
        gap: calc(var(--spacing) * 0.75);
        margin-top: calc(var(--spacing) * 3);
        padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
        background-color: var(--color-paper);
        color: var(--color-accent);
        transition: transform 0.2s ease;
    }

    .contact__action:hover {
        transform: translateY(-2px);
    }

    .contact__action:active {
        transform: translateY(0);
    }

    .contact__action-text {
        font-variation-settings:
            "wdth" 86,
            "wght" 700;
        text-transform: uppercase;
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        line-height: 1;
        white-space: nowrap;
    }

    .contact__action-addr {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
    }

    .contact__links {
        list-style: none;
        margin: calc(var(--spacing) * 4) 0 0;
        padding: calc(var(--spacing) * 2) 0 0;
        border-top: 1px solid rgba(241, 241, 239, 0.34);
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 4);
    }

    .contact__links a {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: border-color 0.2s ease;
    }

    .contact__links a:hover {
        border-bottom-color: var(--color-paper);
    }

    .contact :focus-visible {
        outline-color: var(--color-paper);
    }
</style>
