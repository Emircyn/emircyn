---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import plateSurface from "@/assets/plates/surface.jpg";
import plateCaliper from "@/assets/plates/caliper.jpg";
import plateInstrument from "@/assets/plates/instrument.jpg";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

type Item = {
    index: string;
    name: string;
    tag: string;
    what: string;
    how: string;
    when: string;
    stack: string;
    honesty: string;
};

const items = t("craft.items") as Item[];
const f = t("craft.fields") as Record<string, string>;

// The plates are textures behind the type, one per card.
const textures: ImageMetadata[] = [plateSurface, plateCaliper, plateInstrument];
---

<!-- Act 3. Vertical scroll, lateral travel: the three offers cross the frame
     from the right while the frame holds. On a phone the rail becomes a
     stack and the plates travel against the scroll instead. -->
<section
    id="work"
    class="work grain"
    data-work
    data-thread-stop={t("thread.work")}
    aria-labelledby="work-heading"
>
    <div class="work__pin" data-work-pin>
        <header class="shell work__head">
            <div class="work__title">
                <span class="label">{t("craft.label")}</span>
                <h2 id="work-heading" class="display work__heading balance">
                    {t("craft.heading")}
                </h2>
            </div>
            <p class="label work__note">{t("craft.note")}</p>
        </header>

        <div class="work__rail" data-work-rail>
            {
                items.map((p, i) => (
                    <article class="card" data-work-card>
                        <div class="card__plate" data-work-plate>
                            <Image
                                src={textures[i % textures.length]}
                                alt=""
                                widths={[640, 960, 1400]}
                                sizes="(max-width: 767px) 92vw, 44vw"
                                loading="lazy"
                                decoding="async"
                                class="card__plate-img"
                            />
                        </div>

                        <div class="card__head">
                            <span class="card__index display">{p.index}</span>
                            <div>
                                <h3 class="display card__name">{p.name}</h3>
                                <span class="label">{p.tag}</span>
                            </div>
                        </div>

                        <dl class="card__body">
                            <div>
                                <dt class="label">{f.what}</dt>
                                <dd class="pretty">{p.what}</dd>
                            </div>
                            <div>
                                <dt class="label">{f.how}</dt>
                                <dd class="pretty">{p.how}</dd>
                            </div>
                            <div>
                                <dt class="label">{f.when}</dt>
                                <dd class="pretty">{p.when}</dd>
                            </div>
                            <div>
                                <dt class="label">{f.stack}</dt>
                                <dd class="card__stack">{p.stack}</dd>
                            </div>
                        </dl>

                        <p class="card__honesty label">{p.honesty}</p>

                        <a class="card__link" href="#contact" data-thread-jump>
                            <span class="label label-accent">{f.ask}</span>
                            <svg class="card__link-arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .work {
        position: relative;
        background: var(--color-room);
        isolation: isolate;
    }
    .work__pin {
        position: relative;
        height: 100dvh;
        min-height: 600px;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        /* One column the width of the frame. Without this the rail's content
           width becomes the track width and the head is laid out off-screen. */
        grid-template-columns: minmax(0, 1fr);
        overflow: hidden;
    }
    .work__head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: calc(var(--spacing) * 3);
        padding-top: calc(var(--spacing) * 9);
        padding-bottom: calc(var(--spacing) * 3);
    }
    .work__title {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
    }
    .work__heading {
        margin: 0;
        max-width: 22ch;
        font-size: clamp(1.8rem, 3.2vw, 3.2rem);
    }
    .work__note {
        margin: 0;
        color: var(--g-ink-soft);
        text-align: right;
    }

    .work__rail {
        display: flex;
        gap: calc(var(--spacing) * 3);
        align-items: stretch;
        height: 100%;
        min-height: 0;
        padding-inline: var(--gutter);
        padding-bottom: calc(var(--spacing) * 5);
        will-change: transform;
    }

    .card {
        position: relative;
        flex: none;
        width: min(44vw, 640px);
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr) auto auto;
        gap: calc(var(--spacing) * 2);
        padding: calc(var(--spacing) * 2.5);
        min-height: 0;
        background: var(--color-room-lift);
        border: 1px solid var(--g-rule);
        overflow: hidden;
    }
    .card__plate {
        position: relative;
        height: clamp(120px, 20vh, 240px);
        overflow: hidden;
        background: var(--color-room);
    }
    .card__plate-img {
        position: absolute;
        inset: -10% 0;
        width: 100%;
        height: 120%;
        object-fit: cover;
        /* The plates are paper halftones; on the dark ground they are read
           as negatives, which turns them into the same ink as the room. */
        filter: invert(1) contrast(1.15);
        opacity: 0.5;
        will-change: transform;
    }
    .card__head {
        display: flex;
        gap: calc(var(--spacing) * 2);
        align-items: flex-start;
    }
    .card__index {
        font-size: 3rem;
        line-height: 0.8;
        color: var(--g-accent);
    }
    .card__name {
        margin: 0 0 calc(var(--spacing) * 1) 0;
        font-size: clamp(1.8rem, 2.6vw, 3rem);
    }
    .card__body {
        margin: 0;
        display: grid;
        gap: calc(var(--spacing) * 1.5);
        font-size: 0.88rem;
        line-height: 1.42;
        min-height: 0;
        overflow: hidden;
        color: var(--g-ink-soft);
    }
    .card__body dt {
        margin-bottom: 0.35rem;
    }
    .card__body dd {
        margin: 0;
        color: var(--g-ink);
    }
    .card__stack {
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }
    .card__honesty {
        margin: 0;
        padding-top: calc(var(--spacing) * 2);
        border-top: 1px solid var(--g-rule);
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.4;
    }
    .card__link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        justify-self: start;
        padding-block: 0.4rem;
        transition: transform 160ms var(--ease-out);
    }
    .card__link-arrow {
        color: var(--g-accent);
        transition: transform 160ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
        .card__link:hover .card__link-arrow {
            transform: translateX(6px);
        }
    }

    @media (max-width: 767px) {
        .work__pin {
            height: auto;
            min-height: 0;
        }
        .work__head {
            grid-template-columns: 1fr;
            align-items: start;
        }
        .work__note {
            text-align: left;
        }
        .work__heading {
            font-size: clamp(2rem, 9vw, 3rem);
        }
        .work__rail {
            height: auto;
        }
        .card__plate {
            height: auto;
            aspect-ratio: 16 / 9;
        }
        .card__body {
            overflow: visible;
        }
        .work__head {
            padding-top: calc(var(--spacing) * 8);
        }
        .work__rail {
            flex-direction: column;
            gap: calc(var(--spacing) * 3);
        }
        .card {
            width: 100%;
        }
        .card__body {
            font-size: 1rem;
        }
    }
</style>
