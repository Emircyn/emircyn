---
import { useTranslations, type Locale } from "@/i18n/utils";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

type Item = {
    index: string;
    name: string;
    tag: string;
    line: string;
    stack: string;
    proof: string;
    href: string;
};

const items = t("craft.items") as Item[];
---

<!-- Act 2. Three kinds of work, one line each, and every line points at the
     act that proves it. The projects below show the building, the dial shows
     the measuring, and the page itself is the motion. -->
<section
    id="work"
    class="work grain"
    data-work
    data-thread-stop={t("thread.work")}
    aria-labelledby="work-heading"
>
    <header class="shell work__head">
        <div class="work__title">
            <span class="label">{t("craft.label")}</span>
            <h2 id="work-heading" class="display work__heading balance">
                {t("craft.heading")}
            </h2>
        </div>
        <p class="label work__note">{t("craft.note")}</p>
    </header>

    <ol class="shell work__list">
        {
            items.map((p) => (
                <li class="offer" data-work-row>
                    <span class="offer__rule" aria-hidden="true" data-work-rule />
                    <div class="offer__side">
                        <span class="display offer__index">{p.index}</span>
                        <span class="label offer__tag">{p.tag}</span>
                    </div>
                    <h3 class="display offer__name" data-work-name>
                        {p.name}
                    </h3>
                    <div class="offer__body" data-work-body>
                        <p class="offer__line pretty">{p.line}</p>
                        <p class="offer__stack">{p.stack}</p>
                        <a class="offer__proof" href={p.href}>
                            <span class="label label-accent">{p.proof}</span>
                            <svg class="offer__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M12 4v15M5 13l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .work {
        position: relative;
        background: var(--color-room);
        isolation: isolate;
        padding-block: calc(var(--spacing) * 14) calc(var(--spacing) * 10);
    }
    .work__head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: calc(var(--spacing) * 3);
        padding-bottom: calc(var(--spacing) * 6);
    }
    .work__title {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
    }
    .work__heading {
        margin: 0;
        font-size: clamp(1.8rem, 3.2vw, 3.2rem);
    }
    .work__note {
        margin: 0;
        text-align: right;
    }

    .work__list {
        list-style: none;
        margin: 0;
        display: grid;
    }
    .offer {
        position: relative;
        display: grid;
        gap: calc(var(--spacing) * 2);
        padding-block: calc(var(--spacing) * 5);
    }
    /* The rule above each row is drawn from the thread's side as it enters. */
    .offer__rule {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--g-rule-strong);
        transform-origin: left center;
    }
    .offer__side {
        display: flex;
        align-items: baseline;
        gap: calc(var(--spacing) * 2);
    }
    .offer__index {
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 0.9;
        color: var(--g-accent);
    }
    .offer__name {
        margin: 0;
        font-size: clamp(2.8rem, 8vw, 7.5rem);
        line-height: 0.84;
        transition: color 240ms var(--ease-out);
    }
    .offer__body {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
        align-content: start;
    }
    .offer__line {
        margin: 0;
        font-size: clamp(1.1rem, 1.5vw, 1.35rem);
        line-height: 1.36;
        font-variation-settings: "wdth" 96, "wght" 520;
    }
    .offer__stack {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        line-height: 1.6;
        color: var(--g-ink-soft);
    }
    .offer__proof {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        justify-self: start;
        padding-block: 0.5rem;
    }
    .offer__arrow {
        color: var(--g-accent);
        transition: transform 180ms var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .offer:hover .offer__name {
            color: var(--color-red-lit);
        }
        .offer__proof:hover .offer__arrow {
            transform: translateY(3px);
        }
    }

    /* Desktop: the same 12rem label column as the projects and the paper act,
       so the thread's stamps never sit on the work. */
    @media (min-width: 900px) {
        .offer {
            grid-template-columns: 12rem minmax(0, 1fr) minmax(0, 26rem);
            column-gap: calc(var(--spacing) * 6);
            align-items: start;
        }
        .offer__side {
            flex-direction: column;
            gap: calc(var(--spacing) * 1.5);
            padding-top: 0.4rem;
        }
        .offer__body {
            padding-top: 0.6rem;
        }
    }

    @media (max-width: 767px) {
        .work {
            padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 6);
        }
        .work__head {
            grid-template-columns: 1fr;
            padding-bottom: calc(var(--spacing) * 3);
        }
        .work__note {
            text-align: left;
        }
        .work__heading {
            font-size: clamp(2rem, 9vw, 3rem);
        }
        .offer {
            padding-block: calc(var(--spacing) * 4);
        }
    }
</style>
