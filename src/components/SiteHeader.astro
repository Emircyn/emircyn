---
import { useTranslations, type Locale } from "@/i18n/utils";
import { languages } from "@/i18n/ui";
import { homePath, projectsPath, type Alternates } from "@/lib/projects";

interface Props {
    /** This page in both languages, so the switch lands on the same page. */
    alternates?: Alternates;
}

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
const { alternates = { en: homePath("en"), tr: homePath("tr") } } = Astro.props;
const here = Astro.url.pathname;
const onHome = here === homePath(lang);
const inProjects = here.startsWith(projectsPath(lang));
// On the homepage the action scrolls to the close; elsewhere it opens mail.
const ctaHref = onHome ? "#contact" : undefined;
import { site } from "@/config";
---

<!-- Fixed, minimal: wordmark, the projects, the language pair, one action.
     It inverts itself over the paper grounds, driven from scroll.ts, and it
     keeps its place across page changes (view-transition-name: bar). -->
<header class="bar" data-bar>
    <div class="shell bar__inner">
        <a class="bar__mark label" href={homePath(lang)} aria-current={onHome ? "page" : undefined}>{t("meta.name")}</a>

        <nav class="bar__nav" aria-label={t("thread.label")}>
            <ul class="bar__langs">
                {
                    Object.entries(languages).map(([code, label]) => (
                        <li>
                            <a
                                class="label bar__lang"
                                href={alternates[code as Locale]}
                                hreflang={code}
                                lang={code}
                                aria-current={code === lang ? "true" : undefined}
                            >
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a class="label bar__link" href={projectsPath(lang)} aria-current={inProjects ? "page" : undefined}>
                {t("header.projects")}
            </a>
            <a class="label bar__cta" href={ctaHref ?? `mailto:${site.email}`}>{t("contact.action")}</a>
        </nav>
    </div>
</header>

<style>
    .bar {
        view-transition-name: bar;
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        --bar-ink: var(--color-bone);
        --bar-soft: var(--color-bone-soft);
        --bar-accent: var(--color-red-lit);
        color: var(--bar-ink);
        transition: color 300ms var(--ease-out);
        pointer-events: none;
        /* A short fall-off of the ground behind the bar, so passing copy does
           not print through the wordmark. Redrawn per ground. */
        background: linear-gradient(180deg, rgba(11, 10, 10, 0.96) 0%, rgba(11, 10, 10, 0.8) 55%, transparent 100%);
    }
    .bar[data-bar-paper] {
        background: linear-gradient(180deg, rgba(241, 241, 239, 0.97) 0%, rgba(241, 241, 239, 0.85) 55%, transparent 100%);
    }
    .bar[data-bar-paper] {
        --bar-ink: var(--color-ink);
        --bar-soft: var(--color-ink-soft);
        --bar-accent: var(--color-red);
    }
    .bar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--spacing) * 2);
        padding-block: calc(var(--spacing) * 2.5);
    }
    .bar a {
        pointer-events: auto;
    }
    .bar .label {
        color: var(--bar-soft);
        transition: color 300ms var(--ease-out);
    }
    .bar__mark {
        color: var(--bar-ink) !important;
    }
    .bar__nav {
        display: flex;
        align-items: center;
        gap: calc(var(--spacing) * 4);
    }
    .bar__langs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: calc(var(--spacing) * 2);
    }
    .bar__lang[aria-current="true"] {
        color: var(--bar-ink);
        border-bottom: 1px solid var(--bar-accent);
        padding-bottom: 0.2rem;
    }
    .bar__cta {
        color: var(--bar-accent) !important;
    }
    .bar__link[aria-current="page"] {
        color: var(--bar-ink);
        border-bottom: 1px solid var(--bar-accent);
        padding-bottom: 0.2rem;
    }
    @media (hover: hover) {
        .bar__link:hover,
        .bar__lang:hover {
            color: var(--bar-ink);
        }
    }
    @media (max-width: 767px) {
        .bar__cta {
            display: none;
        }
    }
</style>
