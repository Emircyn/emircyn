---
import { useTranslations, type Locale } from "@/i18n/utils";
import { languages } from "@/i18n/ui";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
const localeHref = (l: string) => `/${l}/`;
---

<!-- Fixed, minimal: wordmark, one action, the language pair. It inverts
     itself over the paper act, driven from scroll.ts. -->
<header class="bar" data-bar>
    <div class="shell bar__inner">
        <a class="bar__mark label" href={localeHref(lang)}>{t("meta.name")}</a>

        <nav class="bar__nav" aria-label={t("thread.label")}>
            <ul class="bar__langs">
                {
                    Object.entries(languages).map(([code, label]) => (
                        <li>
                            <a
                                class="label bar__lang"
                                href={localeHref(code)}
                                hreflang={code}
                                lang={code}
                                aria-current={code === lang ? "true" : undefined}
                            >
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a class="label bar__cta" href="#contact">{t("contact.action")}</a>
        </nav>
    </div>
</header>

<style>
    .bar {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        --bar-ink: var(--color-bone);
        --bar-soft: var(--color-bone-soft);
        --bar-accent: var(--color-red-lit);
        color: var(--bar-ink);
        transition: color 300ms var(--ease-out);
        pointer-events: none;
    }
    .bar[data-bar-paper] {
        --bar-ink: var(--color-ink);
        --bar-soft: var(--color-ink-soft);
        --bar-accent: var(--color-red);
    }
    .bar__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--spacing) * 2);
        padding-block: calc(var(--spacing) * 2.5);
    }
    .bar a {
        pointer-events: auto;
    }
    .bar .label {
        color: var(--bar-soft);
        transition: color 300ms var(--ease-out);
    }
    .bar__mark {
        color: var(--bar-ink) !important;
    }
    .bar__nav {
        display: flex;
        align-items: center;
        gap: calc(var(--spacing) * 4);
    }
    .bar__langs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: calc(var(--spacing) * 2);
    }
    .bar__lang[aria-current="true"] {
        color: var(--bar-ink);
        border-bottom: 1px solid var(--bar-accent);
        padding-bottom: 0.2rem;
    }
    .bar__cta {
        color: var(--bar-accent) !important;
    }
    @media (max-width: 767px) {
        .bar__cta {
            display: none;
        }
    }
</style>
