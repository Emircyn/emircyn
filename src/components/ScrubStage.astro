---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    poster: ImageMetadata;
    alt: string;
    src: string;
    srcMobile?: string;
    span?: number;
    label?: string;
    caption?: string;
    stop?: string;
}

const { poster, alt, src, srcMobile, span = 2.6, label, caption, stop } = Astro.props;
---

<!-- Act 4, the peak. The dial answers the wheel one frame per notch. The
     largest scroll span on the page, and the act before it is the quiet one. -->
<section
    id="measure"
    class="scrub"
    data-scrub-stage
    data-thread-stop={stop}
    style={`--scrub-span:${span}`}
    aria-label={alt}
>
    <div class="scrub__sticky">
        <div class="scrub__frame">
            <Image
                src={poster}
                alt={alt}
                widths={[640, 1024, 1600, 2200]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
                class="scrub__poster"
                data-scrub-poster
            />

            <video
                class="scrub__video"
                data-scrub-video
                data-scrub-src={src}
                data-scrub-src-mobile={srcMobile ?? src}
                muted
                playsinline
                preload="none"
                tabindex="-1"
                aria-hidden="true"></video>

            <div class="scrub__scrim" aria-hidden="true"></div>

            {
                (label || caption) && (
                    <div class="shell scrub__meta" data-scrub-meta>
                        {label && <span class="label label-accent">{label}</span>}
                        {caption && <p class="scrub__caption balance">{caption}</p>}
                    </div>
                )
            }

            <div class="scrub__readout label" data-scrub-readout aria-hidden="true">
                <span data-scrub-pct>000</span>
            </div>
        </div>
    </div>
</section>

<style>
    .scrub {
        position: relative;
        height: calc(var(--scrub-span) * 100dvh);
        background: var(--color-paper);
        --g-accent: var(--color-red);
        --g-ink: var(--color-ink);
        --g-ink-soft: var(--color-ink-soft);
        color: var(--g-ink);
    }
    .scrub__sticky {
        position: sticky;
        top: 0;
        height: 100dvh;
        overflow: hidden;
    }
    .scrub__frame {
        position: absolute;
        inset: 0;
    }
    .scrub__poster,
    .scrub__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .scrub__video {
        opacity: 0;
        transition: opacity 240ms var(--ease-out);
    }
    .scrub[data-scrub-ready] .scrub__video {
        opacity: 1;
    }
    .scrub[data-scrub-ready] .scrub__poster {
        opacity: 0;
    }
    /* A corner of density under the copy, not a full-frame overlay. */
    .scrub__scrim {
        position: absolute;
        left: 0;
        bottom: 0;
        width: min(60%, 760px);
        height: 42%;
        background: radial-gradient(
            120% 100% at 0% 100%,
            rgba(241, 241, 239, 0.92),
            rgba(241, 241, 239, 0.6) 45%,
            transparent 75%
        );
        pointer-events: none;
    }
    .scrub__meta {
        position: absolute;
        left: 0;
        right: 0;
        bottom: calc(var(--spacing) * 6);
        display: grid;
        gap: calc(var(--spacing) * 2);
    }
    .scrub__caption {
        margin: 0;
        max-width: 26ch;
        font-size: clamp(1.4rem, 2.6vw, 2.4rem);
        line-height: 1.12;
        font-variation-settings:
            "wdth" 94,
            "wght" 620;
    }
    .scrub__readout {
        position: absolute;
        top: calc(var(--spacing) * 12);
        right: var(--gutter);
        font-size: clamp(2.4rem, 6vw, 5rem);
        letter-spacing: 0;
        font-variant-numeric: tabular-nums;
        color: var(--color-red);
        line-height: 1;
    }

    @media (max-width: 767px) {
        .scrub__poster,
        .scrub__video {
            object-position: 50% 35%;
        }
        .scrub__scrim {
            width: 100%;
            height: 55%;
            background: linear-gradient(
                180deg,
                transparent,
                rgba(241, 241, 239, 0.86) 45%,
                rgba(241, 241, 239, 0.95)
            );
        }
        .scrub__meta {
            bottom: calc(var(--spacing) * 5);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .scrub {
            height: auto;
        }
        .scrub__sticky {
            position: relative;
            height: 100svh;
        }
        .scrub__readout {
            display: none;
        }
    }
</style>
