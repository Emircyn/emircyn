---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    poster: ImageMetadata;
    alt: string;
    src: string;
    srcMobile?: string;
    span?: number;
    label?: string;
    caption?: string;
    stop?: string;
    /** Measured values the readout steps through as the dial turns. */
    readings?: { site: string; device?: string; value: number; from?: number; unit?: string; decimals?: number; approx?: boolean }[];
    note?: string;
}

const { poster, alt, src, srcMobile, span = 2.6, label, caption, stop, readings, note } = Astro.props;
// Decimal comma in Turkish, point in English: 2,65 MiB, 2.65 MiB.
const num = new Intl.NumberFormat(Astro.currentLocale || "en", { maximumFractionDigits: 2 });
---

<!-- Act 3, the measure. The dial answers the wheel one frame per notch, and
     the readout steps through real Lighthouse scores while it turns: the
     instrument finally reads something. The table under the caption holds the
     same numbers, so without JS or motion nothing is lost. -->
<section
    id="measure"
    class="scrub"
    data-scrub-stage
    data-thread-stop={stop}
    data-scrub-readings={readings ? JSON.stringify(readings) : undefined}
    style={`--scrub-span:${span}`}
    aria-label={alt}
>
    <div class="scrub__sticky">
        <div class="scrub__frame">
            <Image
                src={poster}
                alt={alt}
                widths={[640, 1024, 1600, 2200]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
                class="scrub__poster"
                data-scrub-poster
            />

            <video
                class="scrub__video"
                data-scrub-video
                data-scrub-src={src}
                data-scrub-src-mobile={srcMobile ?? src}
                muted
                playsinline
                preload="none"
                tabindex="-1"
                aria-hidden="true"></video>

            <div class="scrub__scrim" aria-hidden="true"></div>

            {
                (label || caption) && (
                    <div class="shell scrub__meta" data-scrub-meta>
                        {label && <span class="label label-accent">{label}</span>}
                        {caption && <p class="scrub__caption balance">{caption}</p>}
                        {readings && (
                            <ol class="scrub__readings">
                                {readings.map((r, i) => (
                                    <li class="scrub__reading" data-scrub-reading={i}>
                                        <span class="scrub__site">{r.site}</span>
                                        {r.device && <span class="label scrub__device">{r.device}</span>}
                                        <span class="scrub__value">
                                            {r.from !== undefined && <span class="scrub__from">{num.format(r.from)} → </span>}
                                            {r.approx && "~"}
                                            {num.format(r.value)}
                                            {r.unit && <span class="scrub__unit"> {r.unit}</span>}
                                        </span>
                                    </li>
                                ))}
                            </ol>
                        )}
                        {note && <p class="label scrub__note">{note}</p>}
                    </div>
                )
            }

            <div class="scrub__readout label" data-scrub-readout aria-hidden="true">
                <span data-scrub-pct>000</span>
                {readings && <span class="scrub__readout-label" data-scrub-reading-label />}
            </div>
        </div>
    </div>
</section>

<style>
    .scrub {
        position: relative;
        height: calc(var(--scrub-span) * 100dvh);
        background: var(--color-paper);
        --g-accent: var(--color-red);
        --g-ink: var(--color-ink);
        --g-ink-soft: var(--color-ink-soft);
        color: var(--g-ink);
    }
    .scrub__sticky {
        position: sticky;
        top: 0;
        height: 100dvh;
        overflow: hidden;
    }
    .scrub__frame {
        position: absolute;
        inset: 0;
    }
    .scrub__poster,
    .scrub__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .scrub__video {
        opacity: 0;
        transition: opacity 240ms var(--ease-out);
    }
    .scrub[data-scrub-ready] .scrub__video {
        opacity: 1;
    }
    .scrub[data-scrub-ready] .scrub__poster {
        opacity: 0;
    }
    /* A corner of density under the copy, not a full-frame overlay. */
    .scrub__scrim {
        position: absolute;
        left: 0;
        bottom: 0;
        width: min(64%, 820px);
        height: 72%;
        background: radial-gradient(
            120% 100% at 0% 100%,
            rgba(241, 241, 239, 0.92),
            rgba(241, 241, 239, 0.6) 45%,
            transparent 75%
        );
        pointer-events: none;
    }
    /* The readings sit on a sheet of the paper ground, so the dial behind
       them can be as busy as it likes and the copy still reads at 15:1. */
    .scrub__meta {
        position: absolute;
        left: var(--gutter);
        right: auto;
        bottom: calc(var(--spacing) * 6);
        display: grid;
        gap: calc(var(--spacing) * 2);
        width: min(38rem, calc(100% - var(--gutter) * 2));
        max-width: none;
        margin: 0;
        padding: calc(var(--spacing) * 3) calc(var(--spacing) * 3.5);
        box-sizing: border-box;
        background: rgba(241, 241, 239, 0.94);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(25, 25, 25, 0.14);
        box-shadow: 0 30px 60px -30px rgba(25, 25, 25, 0.35);
    }
    .scrub__caption {
        margin: 0;
        max-width: 26ch;
        font-size: clamp(1.4rem, 2.6vw, 2.4rem);
        line-height: 1.12;
        font-variation-settings:
            "wdth" 94,
            "wght" 620;
    }
    .scrub__readings {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        width: 100%;
        border-top: 1px solid rgba(25, 25, 25, 0.34);
    }
    .scrub__reading {
        display: grid;
        /* Fixed columns so the device and score line up across rows. */
        grid-template-columns: minmax(0, 1fr) auto minmax(5.5rem, auto);
        align-items: baseline;
        gap: calc(var(--spacing) * 2);
        padding-block: 0.55rem;
        border-bottom: 1px solid rgba(25, 25, 25, 0.14);
        transition: color 200ms var(--ease-out);
    }
    .scrub__site {
        font-variation-settings: "wdth" 96, "wght" 600;
    }
    .scrub__value {
        /* Always the last column, with or without a device label. */
        grid-column: -2 / -1;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        text-align: right;
        white-space: nowrap;
    }
    .scrub__from,
    .scrub__unit {
        color: var(--g-ink-soft);
    }
    .scrub__reading[data-current] {
        color: var(--color-red);
    }
    .scrub__reading[data-current] .scrub__device {
        color: var(--color-red);
    }
    .scrub__note {
        margin: 0;
        max-width: 30rem;
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.5;
    }
    /* Each new reading rolls in: the number from below (or above, scrolling
       back), the label just after it. Restarted by scrub.ts per reading. */
    .scrub__readout > * {
        display: block;
    }
    .scrub__readout[data-rolling] > * {
        animation: readout-in 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .scrub__readout[data-rolling] > .scrub__readout-label {
        animation-delay: 90ms;
    }
    .scrub__readout[data-rolling="down"] > * {
        --from: -0.6em;
    }
    @keyframes readout-in {
        from {
            opacity: 0;
            transform: translate3d(0, var(--from, 0.6em), 0);
            filter: blur(6px);
        }
    }
    .scrub__readout {
        overflow: hidden;
    }
    .scrub__readout-label {
        display: block;
        margin-top: 0.8rem;
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-align: right;
        color: var(--color-ink);
    }
    .scrub__readout {
        position: absolute;
        top: calc(var(--spacing) * 12);
        right: var(--gutter);
        padding: 0.4rem 0.6rem 0.6rem;
        background: rgba(241, 241, 239, 0.82);
        font-size: clamp(2.4rem, 6vw, 5rem);
        letter-spacing: 0;
        font-variant-numeric: tabular-nums;
        color: var(--color-red);
        line-height: 1;
    }

    @media (max-width: 767px) {
        .scrub__poster,
        .scrub__video {
            object-position: 50% 35%;
        }
        .scrub__scrim {
            width: 100%;
            height: 75%;
            background: linear-gradient(
                180deg,
                transparent,
                rgba(241, 241, 239, 0.86) 45%,
                rgba(241, 241, 239, 0.95)
            );
        }
        /* Narrow: the site and its value on one line, what was measured under. */
        .scrub__reading {
            grid-template-columns: minmax(0, 1fr) auto;
            row-gap: 0.25rem;
        }
        .scrub__device {
            grid-column: 1 / -1;
            grid-row: 2;
        }
        .scrub__value {
            grid-column: 2;
            grid-row: 1;
        }
        .scrub__meta {
            right: var(--gutter);
            width: auto;
            bottom: calc(var(--spacing) * 3);
            padding: calc(var(--spacing) * 2.5) calc(var(--spacing) * 2.5);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .scrub {
            height: auto;
        }
        .scrub__sticky {
            position: relative;
            height: 100svh;
        }
        .scrub__readout {
            display: none;
        }
    }
</style>
