---
import { useTranslations, type Locale } from "@/i18n/utils";
import { site } from "@/config";
import { execSync } from "node:child_process";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

/* Real build facts, not a decorative line that says nothing. The commit comes
   from the host first, because a CI checkout may not have a usable git dir, and
   the whole thing degrades to nothing rather than failing a build. */
function commit(): string | null {
  const fromHost =
    import.meta.env.CF_PAGES_COMMIT_SHA ?? process.env.CF_PAGES_COMMIT_SHA;
  if (fromHost) return String(fromHost).slice(0, 7);
  try {
    // Imported at the top rather than required here: this frontmatter is ESM,
    // so require is not defined and the whole lookup fell into the catch.
    return execSync("git rev-parse --short=7 HEAD", { stdio: ["ignore", "pipe", "ignore"] })
      .toString()
      .trim() || null;
  } catch {
    return null;
  }
}

const built = new Date();
const year = built.getFullYear();
const stamp = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(built);
const sha = commit();
---

<!-- Not a second surface. The page ends once, on the reversed block, and this
     is the fine print along the bottom of it: the same crimson, butted up with
     no seam, separated by one hairline. It is still a body level footer so the
     contentinfo landmark survives; it just stops pretending to be an ending of
     its own. -->
<footer class="site-footer">
    <div class="shell site-footer__inner">
        <span class="site-footer__item site-footer__mark">
            {year} {t("footer.rights")}
        </span>
        <span class="site-footer__item">{t("footer.setIn")}</span>
        <span class="site-footer__item">{t("footer.builtWith")}</span>
        <span class="site-footer__item">
            {t("footer.updated")} {stamp}{
                sha && (
                    <>
                        {" "}
                        <a
                            class="site-footer__sha"
                            href={`${site.repo}/commit/${sha}`}
                            target="_blank"
                            rel="noreferrer">{sha}</a
                        >
                    </>
                )
            }
        </span>
    </div>
</footer>

<style>
    .site-footer {
        background-color: var(--color-accent);
        color: var(--color-paper);
        padding-block: calc(var(--spacing) * 4) calc(var(--spacing) * 6);
    }

    .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 1) calc(var(--spacing) * 4);
        padding-top: calc(var(--spacing) * 3);
        border-top: 1px solid rgba(241, 241, 239, 0.34);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.5;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        /* 4.8:1 on the crimson. This is the smallest text on the page, so it is
           held above the 4.5 threshold rather than at it. */
        color: rgba(241, 241, 239, 0.86);
    }

    .site-footer__mark {
        color: var(--color-paper);
    }

    /* The date stamp is pushed to the far end on a wide measure, the way a
       colophon sits opposite the imprint. */
    .site-footer__item:last-child {
        margin-left: auto;
    }

    @media (max-width: 767px) {
        .site-footer__item:last-child {
            margin-left: 0;
        }
        .site-footer__inner {
            gap: calc(var(--spacing) * 1);
        }
        .site-footer__item {
            flex: 0 0 100%;
        }
    }

    .site-footer__sha {
        border-bottom: 1px solid rgba(241, 241, 239, 0.4);
        padding-bottom: 1px;
        transition: border-color 0.2s ease;
    }

    .site-footer__sha:hover {
        border-bottom-color: var(--color-paper);
    }

    .site-footer :focus-visible {
        outline-color: var(--color-paper);
    }
</style>
