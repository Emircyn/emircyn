---
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "@/i18n/utils";
import portrait from "@/assets/images/hero-portrait.png";
import room from "@/assets/hero/room.jpg";
import roomMobile from "@/assets/hero/room-m.jpg";
import haze from "@/assets/hero/haze.jpg";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const name = t("meta.name") as string;
const [firstName, ...rest] = name.split(" ");
const lastName = rest.join(" ");
const ticker = t("hero.ticker") as string[];
// Doubled so the strip can loop by translating half its own width.
const strip = [...ticker, ...ticker];
---

<!-- Act 1. Four planes, one light. The room is the far plane, the name is
     printed on the wall, the figure stands in front of the name, and the haze
     drifts in front of everything. Scroll separates them; the pointer and an
     idle loop keep them breathing when the wheel stops. -->
<section
    id="hero"
    class="hero grain"
    data-hero
    data-thread-stop={t("thread.hero")}
    aria-labelledby="hero-name"
>
    <div class="hero__pin" data-hero-pin>
        <!-- Far plane -->
        <div class="hero__plane hero__plane--room" data-hero-room>
            <div class="hero__amb hero__amb--room">
                <Image
                    src={room}
                    alt=""
                    widths={[900, 1400, 2000, 2400]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    class="hero__room hero__room--wide"
                />
                <Image
                    src={roomMobile}
                    alt=""
                    widths={[540, 810, 1080]}
                    sizes="100vw"
                    format="avif"
                    quality={55}
                    loading="eager"
                    class="hero__room hero__room--tall"
                />
            </div>
        </div>

        <!-- Mid plane: the name, printed on the wall -->
        <div class="hero__plane hero__plane--type">
            <div class="shell hero__type">
                <h1 id="hero-name" class="hero__name" lang="tr">
                    <span class="hero__line" data-hero-line="0">
                        <span class="hero__line-in">{firstName}</span>
                    </span>
                    <span class="hero__line hero__line--lit" data-hero-line="1">
                        <span class="hero__line-in">{lastName}</span>
                    </span>
                </h1>
            </div>
        </div>

        <!-- Near plane: the figure. Feet anchored to the bottom edge. -->
        <div class="hero__plane hero__plane--figure" data-hero-figure>
            <div class="hero__amb hero__amb--figure">
                <Image
                    src={portrait}
                    alt={name}
                    widths={[400, 560, 720, 1040, 1400]}
                    sizes="(max-width: 767px) 78vw, 44vw"
                    format="avif"
                    quality={60}
                    loading="eager"
                    fetchpriority="high"
                    class="hero__figure"
                />
            </div>
        </div>

        <!-- Front plane: haze, screen-blended, only ever moving -->
        <div class="hero__plane hero__plane--haze" data-hero-haze aria-hidden="true">
            <div class="hero__amb hero__amb--haze">
                <Image
                    src={haze}
                    alt=""
                    widths={[900, 1400, 1800]}
                    sizes="100vw"
                    loading="eager"
                    class="hero__haze hero__haze--img"
                />
                <div class="hero__haze hero__haze--a"></div>
            </div>
        </div>

        <!-- Copy layer -->
        <div class="hero__plane hero__plane--copy">
            <div class="shell hero__copy">
                <div class="hero__meta" data-hero-meta>
                    <span class="label label-accent">{t("meta.role")}</span>
                    <span class="label">{t("meta.location")}</span>
                </div>

                <p class="hero__beat" data-hero-beat>
                    <span class="hero__beat-in">{t("hero.beat")}</span>
                </p>
            </div>

            <!-- An invitation to scroll: most visitors read the first screen as the
                 whole page. A real link to the work, so it also works without JS;
                 it fades out as soon as the page starts to move. -->
            <a class="hero__cue" href="#work" data-hero-cue>
                <span class="label hero__cue-text">{t("hero.scroll")}</span>
                <span class="hero__cue-line" aria-hidden="true"><span class="hero__cue-drop"></span></span>
            </a>

            <div class="ticker hero__ticker" data-hero-ticker aria-hidden="true">
                <div class="ticker__track">
                    {
                        strip.map((item) => (
                            <span class="ticker__item label">
                                <span class="hero__ticker-dot" />
                                {item}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        background: var(--color-room);
        /* Reserved scroll travel for the pin. Overridden by the scroll layer
           through the pin spacer; kept here so the no-JS page still has a
           full-height hero and nothing else. */
        isolation: isolate;
    }

    .hero__pin {
        position: relative;
        height: 100dvh;
        min-height: 600px;
        overflow: hidden;
    }

    .hero__plane {
        position: absolute;
        inset: 0;
        will-change: transform;
    }

    /* Inner wrapper the idle loop and the pointer drive. Separate from the
       plane, which the scroll timeline owns, so the two transforms never
       overwrite each other. */
    .hero__amb {
        position: absolute;
        inset: 0;
        transform: translate3d(
            calc((var(--px, 0) * var(--amb-px, 0) + var(--ax, 0) * var(--amb-ax, 0)) * 1px),
            calc((var(--py, 0) * var(--amb-py, 0) + var(--ay, 0) * var(--amb-ay, 0)) * 1px),
            0
        );
        will-change: transform;
    }

    /* --- Room ---------------------------------------------------------- */
    .hero__amb--room {
        --amb-px: -14;
        --amb-py: -8;
        --amb-ax: 6;
        --amb-ay: 4;
        inset: -4%;
    }
    .hero__room {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 50%;
    }
    .hero__room--tall {
        display: none;
    }

    /* --- Name ---------------------------------------------------------- */
    .hero__plane--type {
        display: flex;
        align-items: flex-end;
    }
    .hero__type {
        padding-bottom: 10vh;
    }
    .hero__name {
        margin: 0;
        font-family: var(--font-display);
        font-variation-settings:
            "wdth" 76,
            "wght" 800;
        text-transform: uppercase;
        font-size: clamp(5.5rem, 13.6vw, 15rem);
        line-height: 0.84;
        letter-spacing: -0.02em;
        color: var(--color-bone);
        display: grid;
    }
    .hero__line {
        display: block;
        white-space: nowrap;
        will-change: transform;
    }
    .hero__line-in {
        display: block;
    }
    .hero__line--lit {
        color: var(--color-red-lit);
        /* Sits a little in from the first line, like a second plate slipped. */
        padding-inline-start: 0.14em;
    }

    /* --- Figure -------------------------------------------------------- */
    .hero__plane--figure {
        pointer-events: none;
    }
    .hero__amb--figure {
        --amb-px: 10;
        --amb-py: 4;
        --amb-ax: -3;
        --amb-ay: 2;
    }
    .hero__figure {
        position: absolute;
        right: 1.5vw;
        bottom: -2%;
        width: min(41vw, 600px);
        height: auto;
        transform-origin: 50% 100%;
        /* The cutout's own alpha edge, drawn in red. Two shadows, one on each
           axis, cached by the compositor while held still. */
        filter: drop-shadow(2px 0 0 var(--color-red-lit))
            drop-shadow(-2px 0 0 var(--color-red-lit))
            drop-shadow(0 2px 0 var(--color-red-lit))
            drop-shadow(0 -2px 0 var(--color-red-lit))
            drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
    }

    /* --- Haze ---------------------------------------------------------- */
    .hero__plane--haze {
        pointer-events: none;
        mix-blend-mode: screen;
    }
    .hero__amb--haze {
        --amb-px: 26;
        --amb-py: 16;
        --amb-ax: 22;
        --amb-ay: 10;
        inset: -10%;
    }
    .hero__haze {
        position: absolute;
        inset: 0;
        background-repeat: no-repeat;
        will-change: transform, opacity;
    }
    .hero__haze--img {
        width: 120%;
        height: 120%;
        inset: -10%;
        object-fit: cover;
        opacity: 0.85;
        animation: haze-b 30s ease-in-out infinite alternate;
    }
    .hero__haze--a {
        background-image:
            radial-gradient(60% 45% at 18% 62%, rgba(255, 50, 71, 0.22), transparent 70%),
            radial-gradient(40% 30% at 70% 30%, rgba(200, 200, 210, 0.08), transparent 70%);
        animation: haze-a 18s ease-in-out infinite alternate;
    }
    @keyframes haze-a {
        from {
            transform: translate3d(-3%, 2%, 0) scale(1);
        }
        to {
            transform: translate3d(3%, -2%, 0) scale(1.08);
        }
    }
    @keyframes haze-b {
        from {
            transform: translate3d(2%, 3%, 0) scale(1.05);
        }
        to {
            transform: translate3d(-4%, -1%, 0) scale(1);
        }
    }

    /* --- Copy ---------------------------------------------------------- */
    .hero__plane--copy {
        pointer-events: none;
        z-index: 3;
    }
    .hero__plane--copy a,
    .hero__plane--copy .hero__ticker {
        pointer-events: auto;
    }
    .hero__copy {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-rows: auto 1fr;
        padding-top: calc(var(--spacing) * 11);
    }
    .hero__meta {
        display: flex;
        justify-content: space-between;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 1.5);
        border-top: 1px solid var(--g-rule-strong);
    }
    .hero__beat {
        align-self: start;
        margin: 0;
        margin-top: 12vh;
        max-width: 22ch;
        font-size: clamp(1.5rem, 3vw, 2.75rem);
        line-height: 1.12;
        font-variation-settings:
            "wdth" 96,
            "wght" 560;
        text-wrap: balance;
        opacity: 0;
        transform: translate3d(0, 24px, 0);
    }
    .hero__beat-in {
        display: block;
    }

    /* --- Scroll cue -----------------------------------------------------
       A small pill above the ticker, on the figure's dark shirt so it reads
       on every screen without touching the name. */
    .hero__cue {
        position: absolute;
        right: var(--gutter);
        bottom: calc(var(--spacing) * 8);
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.7rem 0.95rem 0.7rem 1.1rem;
        border: 1px solid rgba(241, 241, 239, 0.28);
        border-radius: 999px;
        background: rgba(11, 10, 10, 0.62);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        pointer-events: auto;
        transition:
            opacity 400ms var(--ease-out),
            border-color 240ms var(--ease-out);
    }
    .hero__cue-text {
        color: var(--color-bone);
    }
    /* A short run of the crimson thread with a drop sliding down it. */
    .hero__cue-line {
        position: relative;
        width: 2px;
        height: 1.6rem;
        overflow: hidden;
        border-radius: 2px;
        background: rgba(241, 241, 239, 0.2);
    }
    .hero__cue-drop {
        position: absolute;
        left: 0;
        top: 0;
        width: 2px;
        height: 45%;
        border-radius: 2px;
        background: var(--color-red-lit);
        box-shadow: 0 0 8px rgba(255, 50, 71, 0.8);
        animation: cue-drop 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    @keyframes cue-drop {
        from {
            transform: translateY(-110%);
        }
        to {
            transform: translateY(240%);
        }
    }
    @media (hover: hover) {
        .hero__cue:hover {
            border-color: var(--color-red-lit);
        }
    }
    /* Once the page moves, the cue has done its job. */
    :global(html[data-scrolled]) .hero__cue {
        opacity: 0;
        pointer-events: none;
    }

    /* The strip along the floor. Always moving, even when the page is not. */
    .hero__ticker {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding-block: calc(var(--spacing) * 1.5);
        border-top: 1px solid var(--g-rule);
        background: linear-gradient(180deg, transparent, rgba(11, 10, 10, 0.7));
        --ticker-dur: 48s;
    }
    .hero__ticker .label {
        color: var(--color-bone-soft);
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;
    }
    .hero__ticker-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--color-red-lit);
        flex: none;
    }

    /* --- Phone: the type sits above the figure, never behind it ---------- */
    @media (max-width: 767px) {
        .hero__room--wide {
            display: none;
        }
        .hero__room--tall {
            display: block;
        }
        .hero__plane--type {
            align-items: flex-start;
        }
        .hero__type {
            padding-top: 22vh;
            padding-bottom: 0;
        }
        .hero__name {
            font-size: clamp(4.2rem, 22vw, 6.4rem);
        }
        .hero__figure {
            right: 50%;
            transform: translateX(50%);
            width: min(78vw, 360px);
            bottom: 7%;
        }
        /* The beat is two sentences: smaller and wider on a phone, so it ends
           above the figure's head instead of running down its face. */
        .hero__beat {
            margin-top: 7vh;
            max-width: 24ch;
            font-size: clamp(1.05rem, 4.6vw, 1.25rem);
            line-height: 1.2;
            text-shadow: 0 2px 18px rgba(11, 10, 10, 0.8);
        }
        .hero__copy {
            padding-top: calc(var(--spacing) * 9);
        }
        .hero__cue {
            bottom: calc(var(--spacing) * 7.5);
            padding: 0.6rem 0.8rem 0.6rem 0.95rem;
        }
    }

    /* Static composition. The scroll layer never runs, so the second beat is
       shown from the start rather than hidden forever. */
    @media (prefers-reduced-motion: reduce) {
        .hero__cue-drop {
            animation: none;
            transform: translateY(75%);
        }
        .hero__beat {
            opacity: 1;
            transform: none;
        }
        .hero__haze {
            animation: none;
        }
        .hero__line--lit {
            opacity: 0.9;
        }
    }
    @media (prefers-reduced-motion: reduce) and (max-width: 767px) {
        /* Static phone composition: name, then the beat, then the figure,
           each in its own band. */
        .hero__type {
            padding-top: 16vh;
        }
        .hero__beat {
            margin-top: 30vh;
            font-size: 1.05rem;
        }
        .hero__figure {
            width: min(62vw, 300px);
            bottom: -4%;
        }
    }
</style>
