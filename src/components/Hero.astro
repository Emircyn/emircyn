---
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "@/i18n/utils";
import profileImage from "@/assets/images/hero-portrait.png";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const scenes = t("hero.scenes") as { label: string; text: string }[];
const name = t("meta.name") as string;
const role = t("meta.role") as string;

const [firstName, ...restName] = name.split(" ");
const lastName = restName.join(" ");

// Tick marks for the scale. Every fifth one is long and carries a reading.
const ticks = Array.from({ length: 33 }, (_, i) => i);
---

<section id="hero" class="hero" data-hero aria-labelledby="hero-name">
    <div class="hero__pin" data-hero-pin>
        <div class="shell hero__frame">
            <div class="hero__meta">
                <hr class="rule-strong" />
                <div class="hero__meta-row">
                    <span class="label label-accent">{role}</span>
                    <span class="label">{t("meta.location")}</span>
                </div>
            </div>

            <!-- The scale. The width axis of the display face is a real
                 measurement, so the hero shows it the way an instrument would:
                 a ruled scale with a travelling index and a live reading. It is
                 the empty left edge doing work instead of sitting blank. -->
            <div class="hero__scale" aria-hidden="true">
                <div class="hero__scale-rail">
                    {
                        ticks.map((i) => (
                            <span
                                class={`hero__tick${i % 4 === 0 ? " hero__tick--major" : ""}`}
                            />
                        ))
                    }
                    <span class="hero__index" data-hero-index></span>
                </div>
                <span class="label hero__readout">
                    <span class="hero__readout-key">wdth</span>
                    <span class="hero__readout-val" data-hero-readout>62</span>
                </span>
            </div>

            <ol class="hero__scenes" data-hero-scenes>
                {
                    scenes.map((scene, i) => (
                        <li
                            class="hero__scene"
                            data-hero-scene
                            data-scene-index={i}
                        >
                            <span class="label hero__scene-label">
                                <span class="hero__scene-num">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                {scene.label}
                            </span>
                            <p class="hero__scene-text pretty">{scene.text}</p>
                        </li>
                    ))
                }
            </ol>

            <!-- lang="tr" so uppercasing gives the Turkish forms on the English
                 route too. The second line carries the accent, so the name is
                 one mark printed from two plates. -->
            <div class="hero__type">
                <h1 id="hero-name" class="hero__name" lang="tr" data-hero-name>
                    <span class="hero__line" data-hero-line>{firstName}</span>
                    <span class="hero__line hero__line--accent" data-hero-line
                        >{lastName}</span
                    >
                </h1>
            </div>

            <!-- Above everything. The name passes behind the figure; nothing is
                 ever printed across it.

                 The figure is framed the way this page frames anything it is
                 measuring: a hairline box with corner brackets and a plate tag.
                 The crop tightens as the width axis opens, so the frame is
                 reading the same scroll as everything else rather than sitting
                 there as decoration. -->
            <div class="hero__portrait" data-hero-portrait>
                <Image
                    src={profileImage}
                    alt=""
                    widths={[420, 720, 1040]}
                    sizes="(max-width: 767px) 62vw, 38vw"
                    loading="eager"
                    class="hero__portrait-img"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .hero__pin {
        min-height: 100dvh;
        display: flex;
    }

    .hero__frame {
        position: relative;
        width: 100%;
        display: grid;
        grid-template-rows: auto 1fr auto;
        row-gap: calc(var(--spacing) * 3);
        padding-block: calc(var(--spacing) * 9) calc(var(--spacing) * 4);
    }

    .hero__meta-row {
        display: flex;
        justify-content: space-between;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 1.5);
    }

    /* --- The scale ------------------------------------------------------- */

    .hero__scale {
        position: absolute;
        left: var(--gutter);
        top: 22%;
        bottom: 24%;
        width: 3.5rem;
        display: none;
        flex-direction: column;
        gap: calc(var(--spacing) * 1.5);
        z-index: 2;
    }

    .hero__scale-rail {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-left: 1px solid var(--color-rule-strong);
        padding-left: 0;
    }

    .hero__tick {
        display: block;
        width: 0.5rem;
        height: 1px;
        background-color: var(--color-rule);
    }

    .hero__tick--major {
        width: 1.25rem;
        background-color: var(--color-rule-strong);
    }

    /* Travelling index. The element is the full height of the rail and the
       mark is drawn at its top edge, so the travel can be expressed as a
       percentage of the element itself. That is the whole point: a percentage
       cannot disagree with the rail, whereas a pixel figure measured once in
       JS can, and did. It was read before the name band was given its fixed
       height, so it carried the taller pre-layout rail for the rest of the
       session and ran the index a third of the way off the bottom. */
    .hero__index {
        position: absolute;
        left: -1px;
        top: 0;
        width: 2rem;
        height: 100%;
        pointer-events: none;
        transform: translateY(calc(var(--hero-index, 0) * (100% - 2px)));
        will-change: transform;
    }

    .hero__index::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 2px;
        background-color: var(--color-accent);
    }

    .hero__readout {
        display: grid;
        gap: 2px;
        line-height: 1.1;
    }

    .hero__readout-val {
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }

    /* --- Scenes ---------------------------------------------------------- */

    .hero__scenes {
        list-style: none;
        margin: 0;
        padding: 0;
        align-self: start;
        display: grid;
        max-width: 42rem;
    }

    .hero__scene {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
        padding-block: calc(var(--spacing) * 2);
        border-top: 1px solid var(--color-rule);
    }

    .hero__scene:last-child {
        border-bottom: 1px solid var(--color-rule);
    }

    .hero__scene-label {
        display: flex;
        gap: calc(var(--spacing) * 1.5);
    }

    .hero__scene-num {
        color: var(--color-accent);
    }

    .hero__scene-text {
        margin: 0;
        font-size: clamp(1.125rem, 2.2vw, 1.625rem);
        font-variation-settings: "wdth" 100, "wght" 450;
        line-height: 1.26;
        max-width: 30ch;
    }

    /* --- The name -------------------------------------------------------- */

    .hero__type {
        position: relative;
        min-width: 0;
        z-index: 1;
        display: flex;
        align-items: flex-end;
    }

    .hero__name {
        margin: 0;
        display: flex;
        flex-direction: column;
        font-family: var(--font-display);
        font-variation-settings:
            "wdth" var(--hero-wdth),
            "wght" var(--hero-wght);
        text-transform: uppercase;
        /* Opened up. The two lines are one mark, but they need air between them
           to read as a stacked composition rather than a solid block. The band
           reserved in the scroll layer uses this exact figure. */
        line-height: 1.04;
        letter-spacing: -0.012em;
        font-size: clamp(2.75rem, 13vw, 11rem);
        pointer-events: none;
    }

    .hero__line {
        display: block;
        white-space: nowrap;
    }

    /* Two impressions of one mark: the given name in ink, the family name in
       the accent. Both printed solid. Drawn as an outline it went thin and
       unresolved at this size, and the weight of the composition fell out of
       the bottom of the frame. */
    .hero__line--accent {
        color: var(--color-accent);
    }

    /* --- Portrait, above everything -------------------------------------- */

    .hero__portrait {
        position: absolute;
        /* The contour follows the alpha channel, and the alpha channel ends
           where the file does, so without this it draws a straight red rule
           along the bottom crop of the figure. */
        -webkit-mask-image: linear-gradient(
            to bottom,
            #000 calc(100% - 10px),
            transparent calc(100% - 10px)
        );
        mask-image: linear-gradient(
            to bottom,
            #000 calc(100% - 10px),
            transparent calc(100% - 10px)
        );
        z-index: 3;
        right: 0;
        bottom: 0;
        width: 38%;
        max-width: 28rem;
        pointer-events: none;
        will-change: transform;
        /* Anchored, so the parallax scale grows inward instead of pushing the
           figure past the right edge of the viewport. */
        transform-origin: right bottom;
    }

    .hero__portrait-img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: auto;
        display: block;
        /* Applied after the filter, so the contour is drawn first and then
           multiplied with the paper. Against a near-white sheet that leaves
           the accent where it was, and puts the figure back on the page
           rather than a shade brighter than it. */
        mix-blend-mode: multiply;
    }

    /* --- The contour ------------------------------------------------------ */

    /* A border that follows the figure rather than boxing it in. The portrait
       is a cut-out with a real alpha channel, so stacking drop-shadows at zero
       blur in eight directions traces its silhouette exactly: an outline that
       wraps the person, drawn in the same accent the family name is printed in.

       Eight directions rather than four, because four leaves the diagonals
       thin and the contour reads as a cross rather than as a line. */
    .hero__portrait-img {
        /* Constant. Animating the width forces the browser to re-rasterise
           eight drop-shadows on every frame of the scrub; held still, the
           filter is drawn once and cached. Measured: a 227ms hitch on the
           first scroll became nothing. */
        --contour: 2px;
        filter: drop-shadow(var(--contour) 0 0 var(--color-accent))
            drop-shadow(calc(var(--contour) * -1) 0 0 var(--color-accent))
            drop-shadow(0 var(--contour) 0 var(--color-accent))
            drop-shadow(0 calc(var(--contour) * -1) 0 var(--color-accent))
            drop-shadow(
                calc(var(--contour) * 0.72) calc(var(--contour) * 0.72) 0
                    var(--color-accent)
            )
            drop-shadow(
                calc(var(--contour) * -0.72) calc(var(--contour) * 0.72) 0
                    var(--color-accent)
            )
            drop-shadow(
                calc(var(--contour) * 0.72) calc(var(--contour) * -0.72) 0
                    var(--color-accent)
            )
            drop-shadow(
                calc(var(--contour) * -0.72) calc(var(--contour) * -0.72) 0
                    var(--color-accent)
            );
    }

    /* --- Scroll composition ---------------------------------------------- */

    .hero[data-scroll-ready] .hero__scenes {
        grid-template-areas: "scene";
        align-self: center;
    }

    .hero[data-scroll-ready] .hero__scene {
        grid-area: scene;
        border: 0;
        padding-block: 0;
        align-content: start;
        opacity: 0;
    }

    .hero[data-scroll-ready] .hero__scene:last-child {
        border-bottom: 0;
    }

    .hero[data-scroll-ready] .hero__scene-text {
        border-top: 1px solid var(--color-rule-strong);
        padding-top: calc(var(--spacing) * 2);
    }

    @media (min-width: 900px) {
        .hero__scale {
            display: flex;
        }
        /* The scene column clears the scale. */
        /* Everything clears the scale, so it reads as a margin instrument
           rather than something sitting on top of the text. */
        .hero__scenes,
        .hero__meta,
        .hero__type {
            margin-left: 6rem;
        }

        /* The name stops short of the portrait. The figure is on top and the
           type passes behind it, but only grazing the edge: an h1 that loses
           its last letters behind a picture is not a layering effect. */
        .hero__type {
            max-width: 62%;
        }
    }

    /* --- Mobile ----------------------------------------------------------- */

    @media (max-width: 767px) {
        /* Sized so the figure lands exactly on the viewport edge. Anything
           past it is not a bleed, it is a horizontal scrollbar: once the hero
           unpins, the overhang starts contributing to the document width. */
        .hero__portrait {
            width: 48%;
            max-width: none;
            right: 0;
        }

        /* Same rule as desktop, for the same reason. An h1 that loses its last
           letters behind a picture is not a layering effect. */
        .hero__type {
            max-width: 58%;
        }

        /* Handed over to the fixed bar at the top rather than duplicated by it.
           Opacity only: the row keeps its height, so nothing moves. */
        .hero__meta {
            transition: opacity 0.45s ease;
        }

        .hero[data-meta-lifted] .hero__meta {
            opacity: 0;
        }

        .hero__scene-text {
            max-width: none;
            font-size: 1.25rem;
        }

        .hero__scenes {
            max-width: none;
            margin-top: calc(var(--spacing) * 2);
        }

        .hero[data-scroll-ready] .hero__scenes {
            align-self: center;
        }

        .hero[data-scroll-ready] .hero__scene-text {
            font-size: 1.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__meta {
            transition: none;
        }
    }

    @media (min-width: 768px) {
        .hero__frame {
            padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 7);
            row-gap: calc(var(--spacing) * 5);
        }
    }
</style>
