---
import { Image } from "astro:assets";
import { useTranslations, type Locale } from "@/i18n/utils";
import profileImage from "@/assets/images/hero-portrait.png";
import rollerPlate from "@/assets/plates/roller.jpg";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const scenes = t("hero.scenes") as { label: string; text: string }[];
const name = t("meta.name") as string;
const role = t("meta.role") as string;

const [firstName, ...restName] = name.split(" ");
const lastName = restName.join(" ");

// Tick marks for the scale. Every fifth one is long and carries a reading.
const ticks = Array.from({ length: 33 }, (_, i) => i);
---

<section id="hero" class="hero" data-hero aria-labelledby="hero-name">
    <div class="hero__pin" data-hero-pin>
        <div class="shell hero__frame">
            <div class="hero__meta">
                <hr class="rule-strong" />
                <div class="hero__meta-row">
                    <span class="label label-accent">{role}</span>
                    <span class="label">{t("meta.location")}</span>
                </div>
            </div>

            <!-- The scale. The width axis of the display face is a real
                 measurement, so the hero shows it the way an instrument would:
                 a ruled scale with a travelling index and a live reading. It is
                 the empty left edge doing work instead of sitting blank. -->
            <div class="hero__scale" aria-hidden="true">
                <div class="hero__scale-rail">
                    {
                        ticks.map((i) => (
                            <span
                                class={`hero__tick${i % 4 === 0 ? " hero__tick--major" : ""}`}
                            />
                        ))
                    }
                    <span class="hero__index" data-hero-index></span>
                </div>
                <span class="label hero__readout">
                    <span class="hero__readout-key">wdth</span>
                    <span class="hero__readout-val" data-hero-readout>62</span>
                </span>
            </div>

            <ol class="hero__scenes" data-hero-scenes>
                {
                    scenes.map((scene, i) => (
                        <li
                            class="hero__scene"
                            data-hero-scene
                            data-scene-index={i}
                        >
                            <span class="label hero__scene-label">
                                <span class="hero__scene-num">
                                    {String(i + 1).padStart(2, "0")}
                                </span>
                                {scene.label}
                            </span>
                            <p class="hero__scene-text pretty">{scene.text}</p>
                        </li>
                    ))
                }
            </ol>

            <!-- lang="tr" so uppercasing gives the Turkish forms on the English
                 route too. The second line carries the accent, so the name is
                 one mark printed from two plates. -->
            <div class="hero__type">
                <h1 id="hero-name" class="hero__name" lang="tr" data-hero-name>
                    <span class="hero__line" data-hero-line>{firstName}</span>
                    <span class="hero__line hero__line--accent" data-hero-line
                        >{lastName}</span
                    >
                </h1>
            </div>

            <!-- The second moving plane. The roller lays its band of ink across
                 the sheet on exactly the scroll that opens the width axis, so
                 the hero is one move seen twice rather than a still page with
                 an animation parked in the corner. The playhead is driven by
                 the hero timeline, not by this element's own position: the hero
                 is pinned, so the plane never moves on screen and its own rect
                 would report one frozen value for the whole act. -->
            <div
                class="hero__plane"
                data-scrub-stage
                data-scrub-driven="hero"
                aria-label={t("plates.roller")}
            >
                <Image
                    src={rollerPlate}
                    alt=""
                    widths={[520, 900, 1400]}
                    sizes="(max-width: 767px) 92vw, 36vw"
                    loading="lazy"
                    decoding="async"
                    class="hero__plane-still"
                    data-scrub-poster
                />
                <video
                    class="hero__plane-video"
                    data-scrub-video
                    data-scrub-src="/media/roller.mp4"
                    data-scrub-src-mobile="/media/roller-m.mp4"
                    muted
                    playsinline
                    preload="none"
                    tabindex="-1"
                    aria-hidden="true"></video>
            </div>

            <!-- Above everything. The name passes behind the figure; nothing is
                 ever printed across it. -->
            <div class="hero__portrait" data-hero-portrait aria-hidden="true">
                <Image
                    src={profileImage}
                    alt=""
                    widths={[420, 720, 1040]}
                    sizes="(max-width: 767px) 62vw, 38vw"
                    loading="eager"
                    class="hero__portrait-img"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .hero__pin {
        min-height: 100dvh;
        display: flex;
    }

    .hero__frame {
        position: relative;
        width: 100%;
        display: grid;
        grid-template-rows: auto 1fr auto;
        row-gap: calc(var(--spacing) * 3);
        padding-block: calc(var(--spacing) * 9) calc(var(--spacing) * 4);
    }

    .hero__meta-row {
        display: flex;
        justify-content: space-between;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 1.5);
    }

    /* --- The scale ------------------------------------------------------- */

    .hero__scale {
        position: absolute;
        left: var(--gutter);
        top: 22%;
        bottom: 24%;
        width: 3.5rem;
        display: none;
        flex-direction: column;
        gap: calc(var(--spacing) * 1.5);
        z-index: 2;
    }

    .hero__scale-rail {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-left: 1px solid var(--color-rule-strong);
        padding-left: 0;
    }

    .hero__tick {
        display: block;
        width: 0.5rem;
        height: 1px;
        background-color: var(--color-rule);
    }

    .hero__tick--major {
        width: 1.25rem;
        background-color: var(--color-rule-strong);
    }

    /* Travelling index. Sits at the top until the scroll layer moves it. */
    .hero__index {
        position: absolute;
        left: -1px;
        top: 0;
        width: 2rem;
        height: 2px;
        background-color: var(--color-accent);
        will-change: transform;
    }

    .hero__readout {
        display: grid;
        gap: 2px;
        line-height: 1.1;
    }

    .hero__readout-val {
        color: var(--color-accent);
        font-variant-numeric: tabular-nums;
    }

    /* --- Scenes ---------------------------------------------------------- */

    .hero__scenes {
        list-style: none;
        margin: 0;
        padding: 0;
        align-self: start;
        display: grid;
        max-width: 42rem;
    }

    .hero__scene {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
        padding-block: calc(var(--spacing) * 2);
        border-top: 1px solid var(--color-rule);
    }

    .hero__scene:last-child {
        border-bottom: 1px solid var(--color-rule);
    }

    .hero__scene-label {
        display: flex;
        gap: calc(var(--spacing) * 1.5);
    }

    .hero__scene-num {
        color: var(--color-accent);
    }

    .hero__scene-text {
        margin: 0;
        font-size: clamp(1.125rem, 2.2vw, 1.625rem);
        font-variation-settings: "wdth" 100, "wght" 450;
        line-height: 1.26;
        max-width: 30ch;
    }

    /* --- The name -------------------------------------------------------- */

    .hero__type {
        position: relative;
        min-width: 0;
        z-index: 1;
        display: flex;
        align-items: flex-end;
    }

    .hero__name {
        margin: 0;
        display: flex;
        flex-direction: column;
        font-family: var(--font-display);
        font-variation-settings:
            "wdth" var(--hero-wdth),
            "wght" var(--hero-wght);
        text-transform: uppercase;
        /* Opened up. The two lines are one mark, but they need air between them
           to read as a stacked composition rather than a solid block. The band
           reserved in the scroll layer uses this exact figure. */
        line-height: 1.04;
        letter-spacing: -0.012em;
        font-size: clamp(2.75rem, 13vw, 11rem);
        pointer-events: none;
    }

    .hero__line {
        display: block;
        white-space: nowrap;
    }

    /* Two impressions of one mark: the given name in ink, the family name in
       the accent. Both printed solid. Drawn as an outline it went thin and
       unresolved at this size, and the weight of the composition fell out of
       the bottom of the frame. */
    .hero__line--accent {
        color: var(--color-accent);
    }

    /* --- The roller plane ------------------------------------------------ */

    .hero__plane {
        position: absolute;
        z-index: 2;
        overflow: hidden;
        border: 1px solid var(--color-rule-strong);
        background-color: var(--color-paper-sunk);
        /* Desktop: the band of right-hand air above the figure, which was the
           emptiest part of the frame. */
        right: 0;
        top: 13%;
        width: 36%;
        aspect-ratio: 2 / 1;
    }

    .hero__plane-still,
    .hero__plane-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* The still holds the frame until a real video frame has painted. */
    .hero__plane-video {
        opacity: 0;
        transition: opacity 0.2s linear;
    }

    .hero__plane[data-scrub-ready] .hero__plane-video {
        opacity: 1;
    }

    /* Reduced motion, or no script: the plane is simply a printed plate. */
    .hero__plane[data-scrub-static] .hero__plane-video {
        display: none;
    }

    /* --- Portrait, above everything -------------------------------------- */

    .hero__portrait {
        position: absolute;
        z-index: 3;
        right: 0;
        bottom: 0;
        width: 38%;
        max-width: 28rem;
        pointer-events: none;
        will-change: transform;
        /* Anchored, so the parallax scale grows inward instead of pushing the
           figure past the right edge of the viewport. */
        transform-origin: right bottom;
    }

    .hero__portrait-img {
        width: 100%;
        height: auto;
        display: block;
        mix-blend-mode: multiply;
    }

    /* --- Scroll composition ---------------------------------------------- */

    .hero[data-scroll-ready] .hero__scenes {
        grid-template-areas: "scene";
        align-self: center;
    }

    .hero[data-scroll-ready] .hero__scene {
        grid-area: scene;
        border: 0;
        padding-block: 0;
        align-content: start;
        opacity: 0;
    }

    .hero[data-scroll-ready] .hero__scene:last-child {
        border-bottom: 0;
    }

    .hero[data-scroll-ready] .hero__scene-text {
        border-top: 1px solid var(--color-rule-strong);
        padding-top: calc(var(--spacing) * 2);
    }

    @media (min-width: 900px) {
        .hero__scale {
            display: flex;
        }
        /* The scene column clears the scale. */
        /* Everything clears the scale, so it reads as a margin instrument
           rather than something sitting on top of the text. */
        .hero__scenes,
        .hero__meta,
        .hero__type {
            margin-left: 6rem;
        }

        /* The name stops short of the portrait. The figure is on top and the
           type passes behind it, but only grazing the edge: an h1 that loses
           its last letters behind a picture is not a layering effect. */
        .hero__type {
            max-width: 62%;
        }
    }

    /* --- Mobile ----------------------------------------------------------- */

    @media (max-width: 767px) {
        /* Sized so the figure lands exactly on the viewport edge. Anything
           past it is not a bleed, it is a horizontal scrollbar: once the hero
           unpins, the overhang starts contributing to the document width. */
        .hero__portrait {
            width: 48%;
            max-width: none;
            right: 0;
        }

        /* Same rule as desktop, for the same reason. An h1 that loses its last
           letters behind a picture is not a layering effect. */
        .hero__type {
            max-width: 58%;
        }

        /* Handed over to the fixed bar at the top rather than duplicated by it.
           Opacity only: the row keeps its height, so nothing moves. */
        .hero__meta {
            transition: opacity 0.45s ease;
        }

        .hero[data-meta-lifted] .hero__meta {
            opacity: 0;
        }

        /* Mobile: the dead band between the message and the name, which is
           where the composition was emptiest. */
        .hero__plane {
            right: 0;
            left: 0;
            top: 46%;
            width: auto;
            /* Shallower than desktop. The messages run to three lines on a
               narrow measure and they grow downward from the centre of the
               band, so the plane has to clear the tallest of them. */
            aspect-ratio: 2 / 1;
        }

        .hero__scene-text {
            max-width: none;
            font-size: 1.25rem;
        }

        .hero__scenes {
            max-width: none;
            margin-top: calc(var(--spacing) * 2);
        }

        .hero[data-scroll-ready] .hero__scenes {
            align-self: center;
        }

        .hero[data-scroll-ready] .hero__scene-text {
            font-size: 1.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero__meta {
            transition: none;
        }
    }

    @media (min-width: 768px) {
        .hero__frame {
            padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 7);
            row-gap: calc(var(--spacing) * 5);
        }
    }
</style>
