---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Locale } from "@/i18n/utils";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

// Screenshots are picked up by filename: src/assets/projects/01.png and so on.
// A project without one renders without one, so the section is never left
// holding an empty frame.
const shots = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/projects/*.{png,jpg,jpeg,webp}",
    { eager: true },
);
const shotFor = (index: string) => {
    const hit = Object.entries(shots).find(([path]) =>
        path.split("/").pop()?.startsWith(index + "."),
    );
    return hit?.[1].default;
};

type Project = {
    index: string;
    name: string;
    year: string;
    role: string;
    problem: string;
    approach: string;
    stack: string;
    outcome: string;
    honesty: string;
    href: string;
};

const projects = t("work.projects") as Project[];
const f = t("work.fields") as Record<string, string>;
---

<section id="work" class="work" aria-labelledby="work-heading">
    <div class="shell">
        <hr class="rule-strong" />
        <header class="work__head" data-reveal>
            <span class="label">{t("work.label")}</span>
            <h2 id="work-heading" class="display work__heading balance">
                {t("work.heading")}
            </h2>
            <p class="label work__note">{t("work.deadDemoNote")}</p>
        </header>

        {
            projects.map((p, i) => (
                <article class={`project project--${i + 1}`} data-reveal>
                    <hr class="rule" />

                    <div class="project__title">
                        <span class="label label-accent project__index">
                            {p.index}
                        </span>
                        <h3 class="display project__name">{p.name}</h3>
                        <span class="label project__year">{p.year}</span>
                    </div>

                    {
                        shotFor(p.index) && (
                            <div class="project__shot">
                                <Image
                                    src={shotFor(p.index)!}
                                    alt={`${p.name}: ${p.outcome}`}
                                    widths={[640, 1024, 1600]}
                                    sizes="(max-width: 899px) 100vw, 62vw"
                                    loading="lazy"
                                    decoding="async"
                                    class="project__shot-img"
                                />
                            </div>
                        )
                    }

                    <dl class="project__fields">
                        <div class="field field--role">
                            <dt class="label">{f.role}</dt>
                            <dd>{p.role}</dd>
                        </div>
                        <div class="field field--stack">
                            <dt class="label">{f.stack}</dt>
                            <dd class="field__mono">{p.stack}</dd>
                        </div>
                        <div class="field field--problem">
                            <dt class="label">{f.problem}</dt>
                            <dd class="pretty">{p.problem}</dd>
                        </div>
                        <div class="field field--approach">
                            <dt class="label">{f.approach}</dt>
                            <dd class="pretty">{p.approach}</dd>
                        </div>
                        <div class="field field--outcome">
                            <dt class="label">{f.outcome}</dt>
                            <dd class="pretty">{p.outcome}</dd>
                        </div>
                    </dl>

                    <footer class="project__foot">
                        <p class="project__honesty pretty">{p.honesty}</p>
                        <a
                            class="project__link"
                            href={p.href}
                            target="_blank"
                            rel="noreferrer"
                        >
                            <span class="label">{f.source}</span>
                            <span class="project__link-name">{p.name}</span>
                        </a>
                    </footer>
                </article>
            ))
        }
    </div>
</section>

<style>
    .work {
        padding-block: calc(var(--spacing) * 12);
    }

    .work__head {
        display: grid;
        gap: calc(var(--spacing) * 2);
        padding-block: calc(var(--spacing) * 4) calc(var(--spacing) * 8);
        max-width: 52rem;
    }

    .work__heading {
        margin: 0;
        font-size: clamp(2rem, 6vw, 4.5rem);
        font-variation-settings:
            "wdth" 82,
            "wght" 800;
    }

    .work__note {
        color: var(--color-ink-soft);
    }

    /* --- Project shell ---------------------------------------------------- */

    .project {
        padding-block: calc(var(--spacing) * 6);
        display: grid;
        gap: calc(var(--spacing) * 4);
    }

    .project__title {
        display: flex;
        align-items: flex-start;
        gap: calc(var(--spacing) * 2);
        flex-wrap: wrap;
    }

    .project__name {
        margin: 0;
        font-size: clamp(2.25rem, 8vw, 6rem);
        font-variation-settings:
            "wdth" 76,
            "wght" 800;
    }

    /* Sit the mono meta on the cap line of the display name rather than on its
       baseline, which at this size leaves them stranded near the descenders. */
    .project__index,
    .project__year {
        padding-top: 0.55rem;
    }

    .project__year {
        margin-left: auto;
    }

    /* A screenshot is a document, so it sits on the grid with a hairline and a
       sunk ground behind it rather than floating as a rounded card. */
    .project__shot {
        border: 1px solid var(--color-rule);
        background-color: var(--color-paper-sunk);
        overflow: hidden;
    }

    .project__shot-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .project__fields {
        margin: 0;
        display: grid;
        gap: calc(var(--spacing) * 3);
    }

    .field {
        display: grid;
        gap: calc(var(--spacing) * 1);
        align-content: start;
    }

    .field dd {
        margin: 0;
        font-size: 1rem;
        line-height: 1.5;
        max-width: 60ch;
    }

    .field__mono {
        font-family: var(--font-mono);
        font-size: 0.8125rem !important;
        line-height: 1.6 !important;
    }

    .project__foot {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 3);
        align-items: end;
        justify-content: space-between;
        border-top: 1px solid var(--color-rule);
        padding-top: calc(var(--spacing) * 2.5);
    }

    .project__honesty {
        margin: 0;
        max-width: 44ch;
        font-size: 0.875rem;
        color: var(--color-ink-soft);
    }

    .project__link {
        display: grid;
        gap: calc(var(--spacing) * 0.75);
        text-align: right;
        border-bottom: 1px solid var(--color-accent);
        padding-bottom: calc(var(--spacing) * 0.5);
        transition: background-color 0.25s ease;
    }

    .project__link-name {
        font-variation-settings:
            "wdth" 88,
            "wght" 650;
        text-transform: uppercase;
        font-size: 1.125rem;
        line-height: 1;
        color: var(--color-accent);
    }

    .project__link:hover {
        background-color: rgba(179, 0, 27, 0.07);
    }

    /* --- Three distinct compositions --------------------------------------
       Not one card repeated three times. Each project is laid out for the kind
       of thing it is. */

    @media (min-width: 900px) {
        /* 01: architecture rebuild. Wide field table under a full-width title,
           because the story is the set of parts, read across. */
        .project--1 .project__fields {
            grid-template-columns: repeat(4, 1fr);
            column-gap: calc(var(--spacing) * 4);
        }
        .project--1 .field--problem {
            grid-column: 1 / 3;
        }
        .project--1 .field--approach {
            grid-column: 3 / 5;
        }
        .project--1 .field--outcome {
            grid-column: 1 / 3;
        }

        /* The screenshot joins each composition rather than sitting in an
           identical slot three times: wide under the title on 01, aligned to
           the reading column on 02, held to the register width on 03. */
        .project--1 .project__shot {
            margin-inline-end: 12%;
        }
        .project--2 .project__shot {
            margin-inline-start: 22rem;
        }
        .project--3 .project__shot {
            margin-inline-start: 12rem;
            margin-inline-end: 24%;
        }

        /* 02: an API-driven app. Narrow reading column offset to the right,
           with the metadata held in a left rail, so it reads as a case note. */
        .project--2 .project__title {
            justify-content: flex-end;
            text-align: right;
        }
        .project--2 .project__year {
            margin-left: 0;
            order: -1;
            margin-right: auto;
        }
        .project--2 .project__fields {
            grid-template-columns: 16rem 1fr;
            column-gap: calc(var(--spacing) * 6);
        }
        .project--2 .field--role,
        .project--2 .field--stack {
            grid-column: 1;
        }
        .project--2 .field--problem,
        .project--2 .field--approach,
        .project--2 .field--outcome {
            grid-column: 2;
        }

        /* 03: a convention, not an app. A ruled register, one field per row,
           which is the shape of the thing itself. */
        .project--3 .project__fields {
            grid-template-columns: 12rem 1fr;
            column-gap: calc(var(--spacing) * 6);
            gap: 0;
        }
        .project--3 .field {
            display: contents;
        }
        .project--3 .field dt,
        .project--3 .field dd {
            border-top: 1px solid var(--color-rule);
            padding-block: calc(var(--spacing) * 2);
        }
        .project--3 .field dt {
            padding-top: calc(var(--spacing) * 2.4);
        }
    }
</style>
