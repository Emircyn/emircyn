---
interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: URL | string;
    /** This page in both languages. Defaults to the two homepages. */
    alternates?: Alternates;
    /** Extra structured data for this page, emitted after the person and site. */
    jsonLd?: object[];
    ogType?: "profile" | "website" | "article";
}

import { useTranslations } from "@/i18n/utils";
import { site } from "@/config";
import { homePath, type Alternates } from "@/lib/projects";

const lang = (Astro.currentLocale || "en") as "en" | "tr";
const t = useTranslations(lang);

const {
    title = t("seo.title"),
    description = t("seo.description"),
    image = lang === "tr" ? "/og-image-tr.jpg" : "/og-image.jpg",
    canonicalURL = new URL(Astro.url.pathname, Astro.site),
    alternates = { en: homePath("en"), tr: homePath("tr") },
    jsonLd = [],
    ogType = "profile",
} = Astro.props;

const siteTitle =
    title === t("seo.title")
        ? title
        : `${title} | ${t("seo.title").split("|")[0].trim()}`;

const ogLocale = lang === "tr" ? "tr_TR" : "en_US";
const ogAlternate = lang === "tr" ? "en_US" : "tr_TR";
// Bump the version when the card image changes: social networks cache link
// previews by image URL and otherwise keep showing the old card.
const imageURL = new URL(`${image}?v=7`, Astro.site);
// Link previews show about 125 characters; search results about 155.
const socialDescription = ogType === "profile" ? t("seo.socialDescription") : description;

// Structured data: one person, one site. Only facts the page itself states.
const person = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": new URL("/#person", Astro.site).href,
    name: t("meta.name"),
    // The handle people search for. It is the domain and every profile name.
    alternateName: ["emircyn", "Emircan"],
    // The professional title, not the title at a particular employer: the
    // record lists those as they were, so worksFor is left out on purpose.
    jobTitle: t("meta.role"),
    url: Astro.site?.href,
    image: new URL("/og-image.jpg", Astro.site).href,
    email: `mailto:${site.email}`,
    address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
    sameAs: [site.github, site.linkedin],
    knowsAbout: [
        "Full stack development",
        "Large language model integration",
        "TypeScript",
        "Next.js",
        "Nuxt",
        "Astro",
        "PostgreSQL",
        "Stripe",
        "Cloudflare Workers",
        "Web performance",
        "Web animation",
    ],
};
const website = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    url: Astro.site?.href,
    name: t("meta.name"),
    alternateName: "emircyn",
    inLanguage: [lang === "tr" ? "tr-TR" : "en-US"],
    author: { "@id": person["@id"] },
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<!-- Icons, all drawn by scripts/icons.mjs: the .ico for older browsers and
     crawlers, the SVG for everything current. -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0b0a0a" />
<meta name="color-scheme" content="dark" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={t("meta.name")} />
<meta name="robots" content="index,follow,max-image-preview:large" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate Language URLs -->
<link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
<link rel="alternate" hreflang="tr" href={new URL(alternates.tr, Astro.site)} />
<link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={t("meta.name")} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogAlternate} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t("seo.imageAlt")} />
{
    ogType === "profile" && (
        <>
            <meta property="profile:first_name" content="Emircan" />
            <meta property="profile:last_name" content="Erdemci" />
        </>
    )
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={t("seo.imageAlt")} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
