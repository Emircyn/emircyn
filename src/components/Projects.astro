---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Locale } from "@/i18n/utils";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

type Item = {
    index: string;
    slug: string;
    name: string;
    kind: string;
    year: string;
    role: string;
    summary: string;
    detail: string;
    stack: string;
    url: string;
    host: string;
    source?: string;
    alt: string;
    altMobile: string;
    services: string[];
};

type Service = { slug: string; index: string; name: string; line: string; stack: string; proof?: string; href?: string };
const services = t("craft.items") as Service[];

const items = t("projects.items") as Item[];
const f = t("projects.fields") as Record<string, string>;

// Theme-specific shots use dark desktop and light mobile previews. Keep the
// theme in the filename so changing it also changes cached preview URLs.
// Localized screenshots take priority over language-neutral ones.
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.png", { eager: true });
const shot = (slug: string, kind: "desktop" | "mobile") => {
    const base = `/src/assets/projects/${slug}-${kind}`;
    const theme = kind === "desktop" ? "dark" : "light";
    return (
        files[`${base}-${theme}-${lang}.png`] ??
        files[`${base}-${lang}.png`] ??
        files[`${base}-${theme}.png`] ??
        files[`${base}.png`]
    ).default;
};

// Only what the section itself shows: each project, its address, its author.
const list = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: items.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
            "@type": "CreativeWork",
            name: p.name,
            description: p.summary,
            url: p.url,
            dateCreated: p.year,
            creator: { "@id": new URL("/#person", Astro.site).href },
        },
    })),
};
---

<!-- Act 2. What I do and the work that shows it, in one frame. The three
     services hold still in a column while the projects pass beside them, and
     the services each project used light up as it crosses the middle of the
     screen. On narrower screens the column becomes a strip under the bar. -->
<section
    id="work"
    class="projects grain"
    data-projects
    data-thread-stop={t("thread.work")}
    aria-labelledby="work-heading"
>
    <header class="shell projects__head">
        <div class="projects__title">
            <span class="label">{t("projects.label")}</span>
            <h2 id="work-heading" class="display projects__heading balance">
                {t("projects.heading")}
            </h2>
        </div>
        <p class="label projects__note">{t("projects.note")}</p>
    </header>

    <div class="shell works" data-works>
        <aside class="works__index" aria-labelledby="services-heading" data-services>
            <h3 id="services-heading" class="label works__label">{t("craft.label")}</h3>
            <ol class="works__services">
                {
                    services.map((sv) => (
                        <li class="service" data-service={sv.slug}>
                            <span class="service__dot" aria-hidden="true" />
                            <span class="service__index">{sv.index}</span>
                            <span class="service__name">{sv.name}</span>
                            <p class="service__line pretty">{sv.line}</p>
                            <p class="service__stack">{sv.stack}</p>
                            {sv.proof && sv.href && (
                                <a class="service__proof" href={sv.href}>
                                    <span class="label label-accent">{sv.proof}</span>
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                        <path d="M12 4v15M5 13l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            )}
                        </li>
                    ))
                }
            </ol>
        </aside>

    <ol class="projects__list" id="projects">
        {
            items.map((p, i) => (
                <li class:list={["project", i % 2 === 1 && "project--flip"]} data-project data-uses={p.services.join(" ")}>
                    <div class="project__name-row">
                        <span class="display project__index">{p.index}</span>
                        <h3 class="display project__name" data-project-name>
                            {p.name}
                        </h3>
                        <span class="label project__kind">{p.kind}</span>
                    </div>

                    <div class="project__stage">
                        <a
                            class="project__frame"
                            href={p.url}
                            target="_blank"
                            rel="noopener"
                            data-project-frame
                            aria-label={`${p.name}: ${t("projects.visit")}`}
                        >
                            <span class="project__bar" aria-hidden="true">
                                <span class="project__dot" />
                                <span class="project__host">{p.host}</span>
                            </span>
                            <span class="project__screen">
                                <Image
                                    src={shot(p.slug, "desktop")}
                                    alt={p.alt}
                                    widths={[720, 1100, 1600]}
                                    sizes="(max-width: 899px) 92vw, 62vw"
                                    loading="lazy"
                                    decoding="async"
                                    class="project__img"
                                    data-project-img
                                />
                            </span>
                        </a>
                        <div class="project__phone" data-project-phone>
                            <Image
                                src={shot(p.slug, "mobile")}
                                alt={p.altMobile}
                                widths={[260, 420]}
                                sizes="(max-width: 899px) 30vw, 14vw"
                                loading="lazy"
                                decoding="async"
                                class="project__phone-img"
                            />
                        </div>
                    </div>

                    <div class="project__info" data-project-info>
                        <p class="project__summary pretty">{p.summary}</p>
                        <p class="project__detail pretty">{p.detail}</p>
                        <dl class="project__spec">
                            <div>
                                <dt class="label">{f.year}</dt>
                                <dd>{p.year}</dd>
                            </div>
                            <div>
                                <dt class="label">{f.role}</dt>
                                <dd>{p.role}</dd>
                            </div>
                            <div class="project__spec-wide">
                                <dt class="label">{f.stack}</dt>
                                <dd class="project__stack">{p.stack}</dd>
                            </div>
                        </dl>
                        <div class="project__links">
                            <a class="project__link" href={p.url} target="_blank" rel="noopener">
                                <span class="label label-accent">{t("projects.visit")}</span>
                                <svg class="project__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                    <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </a>
                            {p.source && (
                                <a class="project__link" href={p.source} target="_blank" rel="noopener">
                                    <span class="label">{t("projects.source")}</span>
                                    <svg class="project__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                        <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                </li>
            ))
        }
    </ol>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(list)} />
</section>

<style>
    .projects {
        position: relative;
        background: var(--color-room);
        isolation: isolate;
        padding-block: calc(var(--spacing) * 14) calc(var(--spacing) * 12);
    }
    .projects__head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: calc(var(--spacing) * 3);
        padding-bottom: calc(var(--spacing) * 8);
    }
    .projects__title {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
    }
    .projects__heading {
        margin: 0;
        font-size: clamp(1.8rem, 3.2vw, 3.2rem);
    }
    .projects__note {
        margin: 0;
        text-align: right;
    }

    .projects__list {
        list-style: none;
        margin: 0;
        display: grid;
        gap: calc(var(--spacing) * 18);
    }

    .project {
        display: grid;
        gap: calc(var(--spacing) * 4);
        grid-template-columns: minmax(0, 1fr);
    }
    .project__name-row {
        display: flex;
        align-items: flex-start;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 2);
        border-top: 1px solid var(--g-rule-strong);
    }
    .project__index {
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 0.9;
        color: var(--g-accent);
        padding-top: 0.35em;
    }
    .project__name {
        margin: 0;
        font-size: clamp(3.4rem, 11vw, 10.5rem);
        line-height: 0.82;
        will-change: transform;
    }
    .project__kind {
        margin-left: auto;
        padding-top: 0.6rem;
        text-align: right;
    }

    /* Two planes. The frame is the page's surface; the phone sits over its
       lower corner and moves on its own clock. */
    .project__stage {
        position: relative;
        padding-bottom: 6%;
    }
    .project__frame {
        display: block;
        position: relative;
        background: var(--color-room-lift);
        border: 1px solid var(--g-rule);
        overflow: hidden;
        will-change: clip-path;
    }
    .project__bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: 2.25rem;
        padding-inline: 0.9rem;
        border-bottom: 1px solid var(--g-rule);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        color: var(--g-ink-soft);
    }
    .project__dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-red-lit);
        box-shadow: 0 0 10px rgba(255, 50, 71, 0.6);
    }
    .project__host {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .project__screen {
        display: block;
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
    }
    .project__img {
        position: absolute;
        left: 0;
        top: -6%;
        width: 100%;
        height: 112%;
        object-fit: cover;
        object-position: top center;
        transition: filter 400ms var(--ease-out);
        will-change: transform;
    }
    .project__phone {
        position: absolute;
        right: -1.5%;
        bottom: 0;
        width: 21%;
        aspect-ratio: 9 / 19.5;
        padding: 5px;
        border-radius: 1.6rem;
        background: #050505;
        border: 1px solid var(--g-rule-strong);
        box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.9);
        will-change: transform;
    }
    .project__phone-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        border-radius: calc(1.6rem - 5px);
    }
    .project--flip .project__phone {
        right: auto;
        left: -1.5%;
    }

    .project__info {
        display: grid;
        gap: calc(var(--spacing) * 2.5);
        align-content: start;
    }
    .project__summary {
        margin: 0;
        font-size: clamp(1.15rem, 1.6vw, 1.45rem);
        line-height: 1.34;
        font-variation-settings: "wdth" 96, "wght" 560;
    }
    .project__detail {
        margin: 0;
        color: var(--g-ink-soft);
        font-size: 0.95rem;
        line-height: 1.5;
    }
    .project__spec {
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 2);
        border-top: 1px solid var(--g-rule);
    }
    .project__spec dt {
        margin-bottom: 0.45rem;
    }
    .project__spec dd {
        margin: 0;
        font-size: 0.95rem;
    }
    .project__spec-wide {
        grid-column: 1 / -1;
    }
    .project__stack {
        font-family: var(--font-mono);
        font-size: 0.8rem !important;
        line-height: 1.6;
    }
    .project__links {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 3);
        padding-top: calc(var(--spacing) * 1);
    }
    .project__link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding-block: 0.5rem;
    }
    .project__arrow {
        color: var(--g-accent);
        transition: transform 180ms var(--ease-out);
    }


    @media (hover: hover) and (pointer: fine) {
        .project__link:hover .project__arrow {
            transform: translate(3px, -3px);
        }
        .project__frame:hover .project__img {
            filter: brightness(1.06);
        }
        .project__frame:hover + .project__phone,
        .project__frame:focus-visible + .project__phone {
            border-color: var(--color-red-lit);
        }
    }

    /* --- The services index ------------------------------------------ */
    .service__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 1.5px solid var(--color-red-lit);
        flex: none;
        transition:
            background-color 240ms var(--ease-out),
            box-shadow 240ms var(--ease-out);
    }
    .service__index {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        color: var(--g-accent);
    }
    .service__name {
        font-family: var(--font-display);
        font-variation-settings: "wdth" 88, "wght" 760;
        text-transform: uppercase;
        letter-spacing: -0.01em;
    }
    .service__line,
    .service__stack {
        margin: 0;
    }
    .service__proof {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--g-accent);
    }
    /* With JS the index follows the work: the services used by the project in
       the middle of the screen are lit, the rest step back. Without it all
       three read at full strength. */
    .service {
        transition: opacity 320ms var(--ease-out);
    }
    .works[data-live] .service {
        opacity: 0.32;
    }
    .works[data-live] .service[data-on] {
        opacity: 1;
    }
    .service[data-on] .service__dot {
        background: var(--color-red-lit);
        box-shadow: 0 0 12px rgba(255, 50, 71, 0.7);
    }

    /* Wide screens: the index is a column flush with the page edge that holds
       still beside the work. While this act is on screen the thread shows its
       dots only (see scroll.ts), so its labels never sit on the index. */
    @media (min-width: 1200px) {
        .works {
            display: grid;
            grid-template-columns: 17rem minmax(0, 1fr);
            column-gap: calc(var(--spacing) * 8);
            align-items: start;
        }
        .works__index {
            grid-column: 1;
            position: sticky;
            top: 16vh;
        }
        .projects__list {
            grid-column: 2;
        }
        .works__label {
            margin: 0 0 calc(var(--spacing) * 2);
        }
        .works__services {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .service {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            column-gap: 0.75rem;
            row-gap: 0.6rem;
            padding-block: calc(var(--spacing) * 2.5);
            border-top: 1px solid var(--g-rule);
        }
        .service__name {
            grid-column: 1 / -1;
            font-size: 1.9rem;
            line-height: 0.9;
        }
        .service__line {
            grid-column: 1 / -1;
            font-size: 0.92rem;
            line-height: 1.45;
            color: var(--g-ink-soft);
        }
        .service__stack {
            grid-column: 1 / -1;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            line-height: 1.6;
            color: var(--g-ink-soft);
        }
        .service__proof {
            grid-column: 1 / -1;
            justify-self: start;
        }
        .project__name {
            font-size: clamp(3.4rem, 6.4vw, 7.5rem);
        }
    }

    /* Below that, the index is a strip under the bar that stays while the
       work scrolls, names only. */
    @media (max-width: 1199px) {
        .works__index {
            position: sticky;
            top: 3.75rem;
            z-index: 6;
            margin: 0 calc(var(--gutter) * -1) calc(var(--spacing) * 5);
            padding: 0.8rem var(--gutter);
            background: rgba(11, 10, 10, 0.9);
            -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
            border-block: 1px solid var(--g-rule);
        }
        .works__label {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }
        .works__services {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: space-between;
            gap: 1rem;
        }
        .service {
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }
        .service__index,
        .service__line,
        .service__stack,
        .service__proof {
            display: none;
        }
        .service__name {
            font-size: 0.95rem;
        }
    }

    /* Tablet and up: the copy under each frame splits into two columns. */
    @media (min-width: 768px) {
        .project__info {
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
            column-gap: calc(var(--spacing) * 5);
            align-items: start;
        }
        .project__summary,
        .project__detail,
        .project__links {
            grid-column: 1;
        }
        .project__spec {
            grid-column: 2;
            grid-row: 1 / span 3;
            margin-top: 0.35rem;
        }
    }

    @media (max-width: 767px) {
        .projects {
            padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 8);
        }
        .projects__head {
            grid-template-columns: 1fr;
            padding-bottom: calc(var(--spacing) * 5);
        }
        .projects__note {
            text-align: left;
        }
        .projects__heading {
            font-size: clamp(2rem, 9vw, 3rem);
        }
        .projects__list {
            gap: calc(var(--spacing) * 12);
        }
        .project__name-row {
            flex-wrap: wrap;
        }
        .project__kind {
            margin-left: 0;
            width: 100%;
            text-align: left;
            padding-top: 0;
        }
        .project__stage {
            padding-bottom: 14%;
        }
        .project__phone {
            width: 30%;
            border-radius: 1.1rem;
            padding: 3px;
        }
        .project__phone-img {
            border-radius: calc(1.1rem - 3px);
        }
        .project__bar {
            height: 1.9rem;
        }
    }
</style>
