---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Locale } from "@/i18n/utils";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

type Item = {
    index: string;
    slug: string;
    name: string;
    kind: string;
    year: string;
    role: string;
    summary: string;
    detail: string;
    stack: string;
    url: string;
    host: string;
    source?: string;
    alt: string;
    altMobile: string;
};

const items = t("projects.items") as Item[];
const f = t("projects.fields") as Record<string, string>;

// Screenshots live in assets/projects as <slug>-<desktop|mobile>.png. A site
// with its own English version adds <slug>-<desktop|mobile>-en.png, which the
// English page picks up; everything else falls back to the default shot.
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.png", { eager: true });
const shot = (slug: string, kind: "desktop" | "mobile") => {
    const base = `/src/assets/projects/${slug}-${kind}`;
    return (files[`${base}-${lang}.png`] ?? files[`${base}.png`]).default;
};

// Only what the section itself shows: each project, its address, its author.
const list = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: items.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
            "@type": "CreativeWork",
            name: p.name,
            description: p.summary,
            url: p.url,
            dateCreated: p.year,
            creator: { "@id": new URL("/#person", Astro.site).href },
        },
    })),
};
---

<!-- Act 3. The proof after the promise. Each project is two screens on two
     planes: the desktop frame opens from the thread's side as it enters, the
     phone rides over its corner at its own speed. Static without JS. -->
<section
    id="projects"
    class="projects grain"
    data-projects
    data-thread-stop={t("thread.projects")}
    aria-labelledby="projects-heading"
>
    <header class="shell projects__head">
        <div class="projects__title">
            <span class="label">{t("projects.label")}</span>
            <h2 id="projects-heading" class="display projects__heading balance">
                {t("projects.heading")}
            </h2>
        </div>
        <p class="label projects__note">{t("projects.note")}</p>
    </header>

    <ol class="shell projects__list">
        {
            items.map((p, i) => (
                <li class:list={["project", i % 2 === 1 && "project--flip"]} data-project>
                    <div class="project__name-row">
                        <span class="display project__index">{p.index}</span>
                        <h3 class="display project__name" data-project-name>
                            {p.name}
                        </h3>
                        <span class="label project__kind">{p.kind}</span>
                    </div>

                    <div class="project__stage">
                        <a
                            class="project__frame"
                            href={p.url}
                            target="_blank"
                            rel="noopener"
                            data-project-frame
                            aria-label={`${p.name}: ${t("projects.visit")}`}
                        >
                            <span class="project__bar" aria-hidden="true">
                                <span class="project__dot" />
                                <span class="project__host">{p.host}</span>
                            </span>
                            <span class="project__screen">
                                <Image
                                    src={shot(p.slug, "desktop")}
                                    alt={p.alt}
                                    widths={[720, 1100, 1600]}
                                    sizes="(max-width: 899px) 92vw, 62vw"
                                    loading="lazy"
                                    decoding="async"
                                    class="project__img"
                                    data-project-img
                                />
                            </span>
                        </a>
                        <div class="project__phone" data-project-phone>
                            <Image
                                src={shot(p.slug, "mobile")}
                                alt={p.altMobile}
                                widths={[260, 420]}
                                sizes="(max-width: 899px) 30vw, 14vw"
                                loading="lazy"
                                decoding="async"
                                class="project__phone-img"
                            />
                        </div>
                    </div>

                    <div class="project__info" data-project-info>
                        <p class="project__summary pretty">{p.summary}</p>
                        <p class="project__detail pretty">{p.detail}</p>
                        <dl class="project__spec">
                            <div>
                                <dt class="label">{f.year}</dt>
                                <dd>{p.year}</dd>
                            </div>
                            <div>
                                <dt class="label">{f.role}</dt>
                                <dd>{p.role}</dd>
                            </div>
                            <div class="project__spec-wide">
                                <dt class="label">{f.stack}</dt>
                                <dd class="project__stack">{p.stack}</dd>
                            </div>
                        </dl>
                        <div class="project__links">
                            <a class="project__link" href={p.url} target="_blank" rel="noopener">
                                <span class="label label-accent">{t("projects.visit")}</span>
                                <svg class="project__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                    <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </a>
                            {p.source && (
                                <a class="project__link" href={p.source} target="_blank" rel="noopener">
                                    <span class="label">{t("projects.source")}</span>
                                    <svg class="project__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                        <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                </li>
            ))
        }
    </ol>

    <p class="shell label projects__next">
        <span class="projects__next-dot" aria-hidden="true"></span>
        {t("projects.next")}
    </p>

    <script type="application/ld+json" set:html={JSON.stringify(list)} />
</section>

<style>
    .projects {
        position: relative;
        background: var(--color-room);
        isolation: isolate;
        padding-block: calc(var(--spacing) * 14) calc(var(--spacing) * 12);
    }
    .projects__head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: calc(var(--spacing) * 3);
        padding-bottom: calc(var(--spacing) * 8);
    }
    .projects__title {
        display: grid;
        gap: calc(var(--spacing) * 1.5);
    }
    .projects__heading {
        margin: 0;
        font-size: clamp(1.8rem, 3.2vw, 3.2rem);
    }
    .projects__note {
        margin: 0;
        text-align: right;
    }

    .projects__list {
        list-style: none;
        margin: 0;
        display: grid;
        gap: calc(var(--spacing) * 18);
    }

    .project {
        display: grid;
        gap: calc(var(--spacing) * 4);
        grid-template-columns: minmax(0, 1fr);
    }
    .project__name-row {
        display: flex;
        align-items: flex-start;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 2);
        border-top: 1px solid var(--g-rule-strong);
    }
    .project__index {
        font-size: clamp(1.4rem, 2.2vw, 2.2rem);
        line-height: 0.9;
        color: var(--g-accent);
        padding-top: 0.35em;
    }
    .project__name {
        margin: 0;
        font-size: clamp(3.4rem, 11vw, 10.5rem);
        line-height: 0.82;
        will-change: transform;
    }
    .project__kind {
        margin-left: auto;
        padding-top: 0.6rem;
        text-align: right;
    }

    /* Two planes. The frame is the page's surface; the phone sits over its
       lower corner and moves on its own clock. */
    .project__stage {
        position: relative;
        padding-bottom: 6%;
    }
    .project__frame {
        display: block;
        position: relative;
        background: var(--color-room-lift);
        border: 1px solid var(--g-rule);
        overflow: hidden;
        will-change: clip-path;
    }
    .project__bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: 2.25rem;
        padding-inline: 0.9rem;
        border-bottom: 1px solid var(--g-rule);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        color: var(--g-ink-soft);
    }
    .project__dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-red-lit);
        box-shadow: 0 0 10px rgba(255, 50, 71, 0.6);
    }
    .project__host {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .project__screen {
        display: block;
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
    }
    .project__img {
        position: absolute;
        left: 0;
        top: -6%;
        width: 100%;
        height: 112%;
        object-fit: cover;
        object-position: top center;
        transition: filter 400ms var(--ease-out);
        will-change: transform;
    }
    .project__phone {
        position: absolute;
        right: -1.5%;
        bottom: 0;
        width: 21%;
        aspect-ratio: 9 / 19.5;
        padding: 5px;
        border-radius: 1.6rem;
        background: #050505;
        border: 1px solid var(--g-rule-strong);
        box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.9);
        will-change: transform;
    }
    .project__phone-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        border-radius: calc(1.6rem - 5px);
    }
    .project--flip .project__phone {
        right: auto;
        left: -1.5%;
    }

    .project__info {
        display: grid;
        gap: calc(var(--spacing) * 2.5);
        align-content: start;
    }
    .project__summary {
        margin: 0;
        font-size: clamp(1.15rem, 1.6vw, 1.45rem);
        line-height: 1.34;
        font-variation-settings: "wdth" 96, "wght" 560;
    }
    .project__detail {
        margin: 0;
        color: var(--g-ink-soft);
        font-size: 0.95rem;
        line-height: 1.5;
    }
    .project__spec {
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: calc(var(--spacing) * 2);
        padding-top: calc(var(--spacing) * 2);
        border-top: 1px solid var(--g-rule);
    }
    .project__spec dt {
        margin-bottom: 0.45rem;
    }
    .project__spec dd {
        margin: 0;
        font-size: 0.95rem;
    }
    .project__spec-wide {
        grid-column: 1 / -1;
    }
    .project__stack {
        font-family: var(--font-mono);
        font-size: 0.8rem !important;
        line-height: 1.6;
    }
    .project__links {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--spacing) * 3);
        padding-top: calc(var(--spacing) * 1);
    }
    .project__link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding-block: 0.5rem;
    }
    .project__arrow {
        color: var(--g-accent);
        transition: transform 180ms var(--ease-out);
    }

    .projects__next {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: calc(var(--spacing) * 14) auto 0;
    }
    .projects__next-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        border: 1.5px solid var(--color-red-lit);
        animation: projects-pulse 2.4s ease-in-out infinite;
    }
    @keyframes projects-pulse {
        50% {
            background: var(--color-red-lit);
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .project__link:hover .project__arrow {
            transform: translate(3px, -3px);
        }
        .project__frame:hover .project__img {
            filter: brightness(1.06);
        }
        .project__frame:hover + .project__phone,
        .project__frame:focus-visible + .project__phone {
            border-color: var(--color-red-lit);
        }
    }

    /* Desktop: the paper act's grid. A 12rem label column on the left keeps
       the thread's stamps off the work; frame and copy share the rest and
       swap sides on every other project. */
    @media (min-width: 900px) {
        .project {
            grid-template-columns: 12rem minmax(0, 8fr) minmax(0, 4fr);
            column-gap: calc(var(--spacing) * 6);
            row-gap: calc(var(--spacing) * 5);
        }
        .project--flip {
            grid-template-columns: 12rem minmax(0, 4fr) minmax(0, 8fr);
        }
        .project__name-row {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: 12rem minmax(0, 1fr) auto;
            column-gap: calc(var(--spacing) * 6);
        }
        .project__stage {
            grid-column: 2;
        }
        .project__info {
            grid-column: 3;
            padding-top: calc(var(--spacing) * 2);
        }
        .project--flip .project__stage {
            grid-column: 3;
            grid-row: 2;
        }
        .project--flip .project__info {
            grid-column: 2;
            grid-row: 2;
        }
        .projects__next {
            padding-left: calc(var(--gutter) + 12rem + var(--spacing) * 6);
        }
    }

    @media (max-width: 767px) {
        .projects {
            padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 8);
        }
        .projects__head {
            grid-template-columns: 1fr;
            padding-bottom: calc(var(--spacing) * 5);
        }
        .projects__note {
            text-align: left;
        }
        .projects__heading {
            font-size: clamp(2rem, 9vw, 3rem);
        }
        .projects__list {
            gap: calc(var(--spacing) * 12);
        }
        .project__name-row {
            flex-wrap: wrap;
        }
        .project__kind {
            margin-left: 0;
            width: 100%;
            text-align: left;
            padding-top: 0;
        }
        .project__stage {
            padding-bottom: 14%;
        }
        .project__phone {
            width: 30%;
            border-radius: 1.1rem;
            padding: 3px;
        }
        .project__phone-img {
            border-radius: calc(1.1rem - 3px);
        }
        .project__bar {
            height: 1.9rem;
        }
    }
</style>
