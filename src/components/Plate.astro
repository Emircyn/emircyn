---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    /** Why this plate is here, for assistive tech. Never decorative filler. */
    alt: string;
    height?: "band" | "tall";
}

const { src, alt, height = "band" } = Astro.props;
---

<!-- A window onto a larger sheet. The image is oversized inside the frame and
     travels against the scroll, so the frame reads as an aperture over printed
     matter rather than a picture pasted onto the page. Without JS or under
     reduced motion the image simply sits centred in the frame. -->
<figure class={`plate plate--${height}`} data-plate>
    <div class="plate__frame">
        <Image
            src={src}
            alt={alt}
            widths={[640, 1024, 1600, 2200]}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            class="plate__img"
            data-plate-img
        />
    </div>
</figure>

<style>
    .plate {
        margin: 0;
    }

    /* Full bleed out of the shell, because a plate is a printed sheet and a
       printed sheet does not have a text margin. */
    .plate__frame {
        position: relative;
        width: 100vw;
        margin-left: 50%;
        transform: translateX(-50%);
        overflow: hidden;
        background-color: var(--color-paper-sunk);
    }

    .plate--band .plate__frame {
        aspect-ratio: 16 / 5;
    }

    .plate--tall .plate__frame {
        aspect-ratio: 16 / 8;
    }

    .plate__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Oversized only once the parallax is actually running, so the static
       composition is never a cropped image sitting off centre. */
    .plate[data-plate-live] .plate__img {
        position: absolute;
        inset: -16% 0;
        height: 132%;
        will-change: transform;
    }

    @media (max-width: 767px) {
        .plate--band .plate__frame {
            aspect-ratio: 4 / 3;
        }
        .plate--tall .plate__frame {
            aspect-ratio: 3 / 4;
        }
    }
</style>
